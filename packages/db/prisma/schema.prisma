// Oasis Learning Centre — Prisma schema v1
// See oasis-platform-plan.md (§Data model) and docs/ADRs/004, 005.
// PII fields are stored as application-layer ciphertext (see src/encryption.ts);
// suffix `Enc` indicates an encrypted column. Sibling `_bidx` columns hold
// HMAC blind indexes for equality lookups.

generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native", "rhel-openssl-3.0.x"]
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Identity & access
// ---------------------------------------------------------------------------

enum Role {
  Head
  Principal
  Pastor
  HeadOfDiscipline
  TechnicalSupport
  ClubsAdmin
  ClubsLead
  Supervisor
  Parent
  Student
}

enum UserInvitationStatus {
  Pending
  Accepted
}

enum UserInvitationEmailStatus {
  NotSent
  Sent
  Failed
}

enum StudentSelfRegistrationStatus {
  Pending
  AwaitingConsent
  Activated
  Declined
}

enum StudentParentLinkRequestStatus {
  Pending
  Confirmed
  Rejected
  Invited
}

enum ChildRegistrationPromptStatus {
  Unanswered
  NoChildren
  HasChildren
}

enum PaceInventoryOrderStatus {
  Ordered
  InTransit
  Delivered
}

enum DiagnosticOutcome {
  Pass
  Fail
}

model User {
  id                                String                        @id @default(cuid())
  clerkId                           String                        @unique
  role                              Role
  tags                              String[]                      @default([])
  childRegistrationPromptStatus     ChildRegistrationPromptStatus @default(Unanswered)
  childRegistrationPromptAnsweredAt DateTime?
  // --- PII (encrypted, ADR-005) ---
  fullNameEnc                       String
  emailEnc                          String?
  emailBidx                         String?                       @unique
  dobEnc                            String?
  phoneEnc                          String?
  addressEnc                        String?
  // --- operational ---
  active                            Boolean                       @default(true)
  lunchAndClubsVolunteerExempt      Boolean                       @default(false)
  createdAt                         DateTime                      @default(now())
  updatedAt                         DateTime                      @updatedAt

  guardianOf                       Guardian[]
  studentProfile                   Student?                         @relation("StudentLogin")
  behaviourEntries                 BehaviourEntry[]                 @relation("RecordedBehaviour")
  demeritStageOverrides            DemeritStageOverride[]           @relation("DemeritStageOverridesSet")
  childNotesCreated                ChildNote[]                      @relation("ChildNotesCreated")
  deletedBehaviourEntries          BehaviourEntry[]                 @relation("DeletedBehaviour")
  deletedChildNotes                ChildNote[]                      @relation("DeletedChildNotes")
  seenBehaviourEntries             BehaviourEntry[]                 @relation("SeenBehaviour")
  seenChildNotes                   ChildNote[]                      @relation("SeenChildNotes")
  paceRecords                      PaceRecord[]                     @relation("RecordedPace")
  approvedPaceAdvancements         PaceAdvancementApproval[]        @relation("ApprovedPaceAdvancements")
  attendanceRecords                Attendance[]                     @relation("RecordedAttendance")
  specialAttendanceSessionsCreated SpecialAttendanceSession[]       @relation("SpecialAttendanceSessionsCreated")
  specialAttendanceRecords         SpecialAttendanceRecord[]        @relation("RecordedSpecialAttendance")
  availabilityWindows              StaffAvailabilityWindow[]        @relation("StaffAvailability")
  monthlyAvailabilityWindows       StaffMonthlyAvailabilityWindow[] @relation("StaffMonthlyAvailability")
  staffShifts                      StaffShift[]                     @relation("StaffShifts")
  volunteerDays                    ParentVolunteerDay[]             @relation("ParentVolunteerDays")
  requestedShiftSwaps              ShiftSwapRequest[]               @relation("RequestedShiftSwaps")
  targetedShiftSwaps               ShiftSwapRequest[]               @relation("TargetedShiftSwaps")
  approvedShiftSwaps               ShiftSwapRequest[]               @relation("ApprovedShiftSwaps")
  staffAttendance                  StaffAttendance[]                @relation("StaffAttendanceUser")
  recordedStaffAttendance          StaffAttendance[]                @relation("RecordedStaffAttendance")
  noticesPosted                    StaffNotice[]                    @relation("NoticesPosted")
  noticeReads                      StaffNoticeRead[]
  calendarEventsCreated            CalendarEvent[]                  @relation("CalendarEventsCreated")
  requiredCalendarEvents           CalendarEventRequiredPerson[]    @relation("CalendarEventRequiredUser")
  calendarEventTagsCreated         CalendarEventRequiredPerson[]    @relation("CalendarEventRequiredTaggedBy")
  permissionSlipsCreated           PermissionSlip[]                 @relation("PermissionSlipsCreated")
  permissionSlipResponses          PermissionSlipRecipient[]        @relation("PermissionSlipParentResponses")
  permissionSlipPhysicalSignatures PermissionSlipRecipient[]        @relation("PermissionSlipPhysicalSignatures")
  permissionSlipPaymentsMarked     PermissionSlipRecipient[]        @relation("PermissionSlipPaymentsMarked")
  permissionSlipPaymentsConfirmed  PermissionSlipRecipient[]        @relation("PermissionSlipPaymentsConfirmed")
  incidentReportsRecorded          IncidentReport[]                 @relation("IncidentReportsRecorded")
  incidentReportsSignedOff         IncidentReport[]                 @relation("IncidentReportsSignedOff")
  incidentReportsEscalated         IncidentReport[]                 @relation("IncidentReportsEscalated")
  incidentReportsFirstAided        IncidentReport[]                 @relation("IncidentReportsFirstAided")
  incidentStaffLinks               IncidentReportStaff[]            @relation("IncidentReportStaffUser")
  incidentAttachmentsUploaded      IncidentReportAttachment[]       @relation("IncidentReportAttachmentsUploaded")
  incidentParentCopiesGenerated    IncidentReportParentCopy[]       @relation("IncidentParentCopiesGenerated")
  incidentParentCopiesShared       IncidentReportParentCopy[]       @relation("IncidentParentCopiesShared")
  incidentParentRecipients         IncidentReportParentRecipient[]  @relation("IncidentParentRecipients")
  incidentEvents                   IncidentReportEvent[]            @relation("IncidentReportEvents")
  messagesSent                     Message[]                        @relation("MessagesSent")
  messageReads                     MessageRead[]
  messageThreadParticipants        MessageThreadParticipant[]
  threadsAsParent                  MessageThread[]                  @relation("ThreadParent")
  threadsAsSupervisor              MessageThread[]                  @relation("ThreadSupervisor")
  threadsAsAdmin                   MessageThread[]                  @relation("ThreadAdmin")
  communityGroupsCreated           CommunityGroup[]                 @relation("CommunityGroupsCreated")
  communityGroupsUpdated           CommunityGroup[]                 @relation("CommunityGroupsUpdated")
  communityMembershipsUpdated      CommunityGroupMember[]           @relation("CommunityGroupMembershipsUpdated")
  communityMessagesDeleted         CommunityMessage[]               @relation("CommunityMessagesDeleted")
  shopPurchases                    ShopPurchase[]                   @relation("Shopkeeper")
  shopItemsCreated                 ShopItem[]                       @relation("ShopItemsCreated")
  shopReservationsMade             ShopReservation[]                @relation("ShopReservationCreator")
  shopReservationsCollected        ShopReservation[]                @relation("ShopReservationCollector")
  shopReservationsCancelled        ShopReservation[]                @relation("ShopReservationCanceller")
  clubsCreated                     Club[]                           @relation("ClubsCreated")
  clubSignupsCreated               ClubSignup[]                     @relation("SignupsCreated")
  clubNotifications                ClubNotification[]               @relation("ClubNotificationsSent")
  clubAttendanceRecords            ClubAttendance[]                 @relation("RecordedClubAttendance")
  clubLeadAssignments              ClubLeadAssignment[]             @relation("ClubLeadAssignedUsers")
  clubLeadAssignmentsMade          ClubLeadAssignment[]             @relation("ClubLeadAssignmentsMade")
  clubRotaSelections               ClubRotaParticipant[]            @relation("ClubRotaSelectedUsers")
  clubRotaParticipants             ClubRotaParticipant[]            @relation("ClubRotaParticipants")
  clubRotaShifts                   ClubRotaShift[]                  @relation("ClubRotaShifts")
  clubAvailabilityWindows          ClubAvailabilityWindow[]         @relation("ClubAvailability")
  schoolFeeInvoicesCreated         SchoolFeeInvoice[]               @relation("SchoolFeeInvoicesCreated")
  schoolFeeInvoicesMarked          SchoolFeeInvoice[]               @relation("SchoolFeeInvoicesParentMarkedPaid")
  schoolFeeInvoicesConfirmed       SchoolFeeInvoice[]               @relation("SchoolFeeInvoicesPaymentConfirmed")
  schoolFeeDiscountOptOuts         SchoolFeeInvoiceDiscount[]       @relation("SchoolFeeDiscountOptedOutBy")
  auditEvents                      AuditLog[]
  invitationsSent                  UserInvitation[]                 @relation("InvitedUserInvitations")
  acceptedInvitations              UserInvitation[]                 @relation("AcceptedUserInvitations")
  spouseInvitationsSent            UserInvitation[]                 @relation("GuardianLinkInviterInvitations")
  studentRegistrationCodesCreated  StudentRegistrationCode[]        @relation("StudentRegistrationCodesCreated")
  studentSelfRegistrationsApproved StudentSelfRegistration[]        @relation("StudentSelfRegistrationsApproved")
  studentSelfRegistrationsDeclined StudentSelfRegistration[]        @relation("StudentSelfRegistrationsDeclined")
  studentParentLinkRequests        StudentParentLinkRequest[]       @relation("StudentParentLinkRequestTarget")
  parentRegistration               ParentRegistration?              @relation("ParentRegistrationParent")
  studentPortalSettingsUpdated     StudentPortalSettings[]          @relation("StudentPortalSettingsUpdated")
  studentPortalParentLocksUpdated  StudentPortalSettings[]          @relation("StudentPortalParentLocksUpdated")
  studentPortalHeadLocksUpdated    StudentPortalSettings[]          @relation("StudentPortalHeadLocksUpdated")
  studentPortalShopBlocksUpdated   StudentPortalSettings[]          @relation("StudentPortalShopBlocksUpdated")
  studentPortalIconPhotosUpdated   StudentPortalSettings[]          @relation("StudentPortalIconPhotosUpdated")
  studentCommunityBlocksUpdated    StudentPortalSettings[]          @relation("StudentCommunityMessagingBlocksUpdated")
  faithCornerCreated               FaithCornerContent[]             @relation("FaithCornerCreated")
  faithCornerUpdated               FaithCornerContent[]             @relation("FaithCornerUpdated")
  faithCornerCommentsReviewed      FaithCornerComment[]             @relation("FaithCornerCommentsReviewed")
  studentNotificationsCreated      StudentNotification[]            @relation("StudentNotificationsCreated")
  paceInventoryOrdersCreated       PaceInventoryOrder[]             @relation("PaceInventoryOrdersCreated")
  diagnosticResultsRecorded        DiagnosticResult[]               @relation("DiagnosticResultsRecorded")
  homeworkAssignmentsCreated         HomeworkAssignment[]              @relation("HomeworkAssignmentsCreated")
  homeworkSubmissionsReviewed        HomeworkSubmission[]              @relation("HomeworkSubmissionsReviewed")
  homeworkSubmissionImagesUploaded   HomeworkSubmissionImage[]         @relation("HomeworkSubmissionImagesUploaded")
  homeworkAssignmentImagesUploaded   HomeworkAssignmentImage[]         @relation("HomeworkAssignmentImagesUploaded")
  charityPotsUpdated               CharityPot[]                     @relation("CharityPotUpdated")

  @@index([role])
}

model UserInvitation {
  id                         String                    @id @default(cuid())
  clerkInvitationId          String                    @unique
  role                       Role
  tags                       String[]                  @default([])
  emailEnc                   String
  emailBidx                  String
  status                     UserInvitationStatus      @default(Pending)
  emailStatus                UserInvitationEmailStatus @default(NotSent)
  emailMessageId             String?
  invitedById                String
  acceptedUserId             String?
  acceptedAt                 DateTime?
  guardianLinkInviterId      String?
  guardianLinkStudentIds     String[]                  @default([])
  studentId                  String?                   @unique
  studentSelfRegistrationId  String?                   @unique
  studentParentLinkRequestId String?                   @unique
  createdAt                  DateTime                  @default(now())
  updatedAt                  DateTime                  @updatedAt

  invitedBy                User                      @relation("InvitedUserInvitations", fields: [invitedById], references: [id])
  acceptedUser             User?                     @relation("AcceptedUserInvitations", fields: [acceptedUserId], references: [id])
  guardianLinkInviter      User?                     @relation("GuardianLinkInviterInvitations", fields: [guardianLinkInviterId], references: [id], onDelete: SetNull)
  student                  Student?                  @relation("StudentLoginInvitation", fields: [studentId], references: [id], onDelete: SetNull)
  studentSelfRegistration  StudentSelfRegistration?  @relation(fields: [studentSelfRegistrationId], references: [id], onDelete: SetNull)
  studentParentLinkRequest StudentParentLinkRequest? @relation(fields: [studentParentLinkRequestId], references: [id], onDelete: SetNull)

  @@index([emailBidx, status])
  @@index([status, role, createdAt])
  @@index([invitedById, createdAt])
  @@index([acceptedUserId])
  @@index([guardianLinkInviterId, createdAt])
  @@index([studentId])
  @@index([studentSelfRegistrationId])
  @@index([studentParentLinkRequestId])
}

// ---------------------------------------------------------------------------
// Students & academic
// ---------------------------------------------------------------------------

model Student {
  id            String   @id @default(cuid())
  userId        String?  @unique
  user          User?    @relation("StudentLogin", fields: [userId], references: [id])
  // --- PII (encrypted) ---
  fullNameEnc   String
  nameBidx      String // HMAC of normalised name for staff search
  dobEnc        String
  addressEnc    String?
  // --- operational ---
  yearGroup     String
  enrolmentDate DateTime
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  guardians                Guardian[]
  subjects                 StudentSubject[]
  paceRecords              PaceRecord[]
  paceProgress             PaceProgress[]
  paceAdvancementApprovals PaceAdvancementApproval[]
  attendance               Attendance[]
  specialAttendanceRecords SpecialAttendanceRecord[]
  behaviour                BehaviourEntry[]
  demeritStageOverrides    DemeritStageOverride[]
  childNotes               ChildNote[]
  meritLedger              MeritLedger[]
  titheConfig              TitheConfig?
  titheRuns                TitheRun[]
  savingsInterestRuns      SavingsInterestRun[]
  investment               InvestmentAccount?
  investmentHolding        InvestmentHolding[]
  investmentTx             InvestmentTransaction[]
  investmentDividendPayment InvestmentDividendPayment[]
  shopPurchases            ShopPurchase[]
  shopReservations         ShopReservation[]
  clubSignups              ClubSignup[]
  clubAttendance           ClubAttendance[]
  termReports              TermReport[]
  schoolFeeInvoices        SchoolFeeInvoice[]
  schoolFeeInvoiceLinks    SchoolFeeInvoiceStudent[]
  permissionSlipRecipients PermissionSlipRecipient[]
  incidentReports          IncidentReportStudent[]
  incidentParentCopies     IncidentReportParentCopy[]
  registrationProfile      StudentRegistrationProfile?
  portalSettings           StudentPortalSettings?
  portalUsageMinutes       StudentPortalUsageMinute[]
  notifications            StudentNotification[]
  homeworkSubmissions      HomeworkSubmission[]
  faithCornerLikes         FaithCornerContentLike[]
  faithCornerComments      FaithCornerComment[]
  faithCornerCommentLikes  FaithCornerCommentLike[]
  communityMemberships   CommunityGroupMember[]
  communityMessages      CommunityMessage[]      @relation("CommunityMessagesSent")
  communityMessageReads  CommunityMessageRead[]
  paceInventoryOrders    PaceInventoryOrder[]
  diagnosticResults      DiagnosticResult[]
  loginInvitation          UserInvitation?             @relation("StudentLoginInvitation")
  selfRegistration         StudentSelfRegistration?
  parentLinkRequests       StudentParentLinkRequest[]

  @@index([yearGroup])
  @@index([nameBidx])
}

model StudentRegistrationCode {
  id          String    @id @default(cuid())
  codeBidx    String    @unique
  label       String
  active      Boolean   @default(true)
  maxUses     Int?
  usedCount   Int       @default(0)
  expiresAt   DateTime?
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  createdBy     User                      @relation("StudentRegistrationCodesCreated", fields: [createdById], references: [id])
  registrations StudentSelfRegistration[]

  @@index([active, expiresAt])
  @@index([createdById, createdAt])
}

model StudentSelfRegistration {
  id                       String                        @id @default(cuid())
  firstNameEnc             String
  lastNameEnc              String
  fullNameEnc              String
  emailEnc                 String
  emailBidx                String
  dobEnc                   String
  yearGroup                String
  registrationCodeId       String
  status                   StudentSelfRegistrationStatus @default(Pending)
  parentConsentConfirmedAt DateTime?
  approvedById             String?
  approvedAt               DateTime?
  declinedById             String?
  declinedAt               DateTime?
  declineReasonEnc         String?
  activationEmailSentAt    DateTime?
  activationEmailMessageId String?
  studentId                String?                       @unique
  createdAt                DateTime                      @default(now())
  updatedAt                DateTime                      @updatedAt

  registrationCode   StudentRegistrationCode    @relation(fields: [registrationCodeId], references: [id])
  approvedBy         User?                      @relation("StudentSelfRegistrationsApproved", fields: [approvedById], references: [id], onDelete: SetNull)
  declinedBy         User?                      @relation("StudentSelfRegistrationsDeclined", fields: [declinedById], references: [id], onDelete: SetNull)
  student            Student?                   @relation(fields: [studentId], references: [id], onDelete: SetNull)
  invitation         UserInvitation?
  parentLinkRequests StudentParentLinkRequest[]

  @@index([status, createdAt])
  @@index([emailBidx, status])
  @@index([registrationCodeId, createdAt])
  @@index([approvedById, approvedAt])
  @@index([declinedById, declinedAt])
}

model StudentParentLinkRequest {
  id                        String                         @id @default(cuid())
  studentSelfRegistrationId String
  studentId                 String?
  parentEmailEnc            String
  parentEmailBidx           String
  parentNameEnc             String?
  existingAccount           Boolean
  targetUserId              String?
  status                    StudentParentLinkRequestStatus @default(Pending)
  confirmedAt               DateTime?
  rejectedAt                DateTime?
  invitedAt                 DateTime?
  createdAt                 DateTime                       @default(now())
  updatedAt                 DateTime                       @updatedAt

  studentSelfRegistration StudentSelfRegistration @relation(fields: [studentSelfRegistrationId], references: [id])
  student                 Student?                @relation(fields: [studentId], references: [id], onDelete: SetNull)
  targetUser              User?                   @relation("StudentParentLinkRequestTarget", fields: [targetUserId], references: [id], onDelete: SetNull)
  invitation              UserInvitation?

  @@unique([studentSelfRegistrationId, parentEmailBidx])
  @@index([targetUserId, status, createdAt])
  @@index([studentId, status])
  @@index([parentEmailBidx, status])
}

model Guardian {
  id        String   @id @default(cuid())
  userId    String
  studentId String
  user      User     @relation(fields: [userId], references: [id])
  student   Student  @relation(fields: [studentId], references: [id])
  notesEnc  String?
  createdAt DateTime @default(now())

  @@unique([userId, studentId])
  @@index([studentId])
}

model StudentPortalSettings {
  id                        String    @id @default(cuid())
  studentId                 String    @unique
  loginHandleEnc            String?
  loginHandleBidx           String?   @unique
  studentCanManagePassword  Boolean   @default(false)
  dailyUsageLimitMinutes    Int?
  offLimitWeekdays          Int[]     @default([])
  parentAccountLocked       Boolean   @default(false)
  parentLockReasonEnc       String?
  headAcademicLocked        Boolean   @default(false)
  headAcademicLockReasonEnc String?
  parentMeritShopBlocked    Boolean   @default(false)
  paceStatusVisible         Boolean   @default(true)
  communityMessagingBlocked Boolean   @default(false)
  communityMessagingBlockedReasonEnc String?
  settingsUpdatedById       String?
  settingsUpdatedAt         DateTime?
  parentLockUpdatedById     String?
  parentLockUpdatedAt       DateTime?
  headLockUpdatedById       String?
  headLockUpdatedAt         DateTime?
  shopBlockUpdatedById      String?
  shopBlockUpdatedAt        DateTime?
  childIconPhotoUrl         String?
  childIconPhotoBucket      String?
  childIconPhotoPathEnc     String?
  childIconPhotoMimeType    String?
  childIconPhotoSizeBytes   Int?
  childIconPhotoUpdatedById String?
  childIconPhotoUpdatedAt   DateTime?
  communityMessagingBlockedById String?
  communityMessagingBlockedAt   DateTime?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  student             Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  settingsUpdatedBy   User?   @relation("StudentPortalSettingsUpdated", fields: [settingsUpdatedById], references: [id], onDelete: SetNull)
  parentLockUpdatedBy User?   @relation("StudentPortalParentLocksUpdated", fields: [parentLockUpdatedById], references: [id], onDelete: SetNull)
  headLockUpdatedBy   User?   @relation("StudentPortalHeadLocksUpdated", fields: [headLockUpdatedById], references: [id], onDelete: SetNull)
  shopBlockUpdatedBy  User?   @relation("StudentPortalShopBlocksUpdated", fields: [shopBlockUpdatedById], references: [id], onDelete: SetNull)
  iconPhotoUpdatedBy  User?   @relation("StudentPortalIconPhotosUpdated", fields: [childIconPhotoUpdatedById], references: [id], onDelete: SetNull)
  communityMessagingBlockedBy User? @relation("StudentCommunityMessagingBlocksUpdated", fields: [communityMessagingBlockedById], references: [id], onDelete: SetNull)

  @@index([settingsUpdatedById, settingsUpdatedAt])
  @@index([parentLockUpdatedById, parentLockUpdatedAt])
  @@index([headLockUpdatedById, headLockUpdatedAt])
  @@index([shopBlockUpdatedById, shopBlockUpdatedAt])
  @@index([childIconPhotoUpdatedById, childIconPhotoUpdatedAt])
  @@index([communityMessagingBlockedById, communityMessagingBlockedAt])
}

model StudentPortalUsageMinute {
  id              String   @id @default(cuid())
  studentId       String
  minuteStartedAt DateTime
  sessionKey      String?
  firstSeenAt     DateTime @default(now())
  lastSeenAt      DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, minuteStartedAt])
  @@index([studentId, minuteStartedAt])
}

enum StudentNotificationKind {
  MeritAward
  ShopPurchase
  ClubNotice
  SystemAnnouncement
}

model StudentNotification {
  id           String                  @id @default(cuid())
  studentId    String
  kind         StudentNotificationKind
  title        String
  bodyEnc      String
  sourceEntity String?
  sourceId     String?
  createdById  String?
  readAt       DateTime?
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdBy User?   @relation("StudentNotificationsCreated", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([studentId, readAt, createdAt])
  @@index([studentId, kind, createdAt])
  @@index([sourceEntity, sourceId])
  @@index([createdById, createdAt])
}

enum HomeworkSubmissionMethod {
  UploadImage
  InPerson
}

model HomeworkAssignment {
  id                String                   @id @default(cuid())
  title             String
  descriptionEnc    String
  dueDate           DateTime                 @db.Date
  submissionMethod  HomeworkSubmissionMethod
  allYearGroupBands Boolean                  @default(true)
  active            Boolean                  @default(true)
  createdById       String
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  createdBy      User                     @relation("HomeworkAssignmentsCreated", fields: [createdById], references: [id])
  bands          HomeworkAssignmentBand[]
  submissions    HomeworkSubmission[]
  questionImages HomeworkAssignmentImage[] @relation("HomeworkAssignmentImages")

  @@index([active, dueDate])
  @@index([createdById, createdAt])
}

model HomeworkAssignmentBand {
  assignmentId    String
  yearGroupBandId String
  createdAt       DateTime @default(now())

  assignment    HomeworkAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  yearGroupBand YearGroupBand      @relation(fields: [yearGroupBandId], references: [id], onDelete: Restrict)

  @@id([assignmentId, yearGroupBandId])
  @@index([yearGroupBandId])
}

model HomeworkSubmission {
  id               String    @id @default(cuid())
  assignmentId     String
  studentId        String
  submittedAt      DateTime?
  reviewedAt       DateTime?
  reviewedById     String?
  scorePercent     Int?
  commentsEnc      String?
  meritAmount      Int       @default(0)
  behaviourEntryId String?   @unique
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  assignment     HomeworkAssignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student        Student                  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  reviewedBy     User?                    @relation("HomeworkSubmissionsReviewed", fields: [reviewedById], references: [id], onDelete: SetNull)
  behaviourEntry BehaviourEntry?          @relation("HomeworkSubmissionBehaviour", fields: [behaviourEntryId], references: [id], onDelete: SetNull)
  images         HomeworkSubmissionImage[]

  @@unique([assignmentId, studentId])
  @@index([studentId, reviewedAt, submittedAt])
  @@index([assignmentId, reviewedAt])
  @@index([reviewedById, reviewedAt])
}

model HomeworkSubmissionImage {
  id                  String   @id @default(cuid())
  submissionId        String
  uploadedById        String
  originalFileNameEnc String
  mimeType            String
  sizeBytes           Int
  storageBucket       String
  storagePathEnc      String
  createdAt           DateTime @default(now())

  submission HomeworkSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  uploadedBy User               @relation("HomeworkSubmissionImagesUploaded", fields: [uploadedById], references: [id])

  @@index([submissionId, createdAt])
  @@index([uploadedById, createdAt])
}

model HomeworkAssignmentImage {
  id                  String   @id @default(cuid())
  assignmentId        String
  uploadedById        String
  originalFileNameEnc String
  mimeType            String
  sizeBytes           Int
  storageBucket       String
  storagePathEnc      String
  createdAt           DateTime @default(now())

  assignment HomeworkAssignment @relation("HomeworkAssignmentImages", fields: [assignmentId], references: [id], onDelete: Cascade)
  uploadedBy User               @relation("HomeworkAssignmentImagesUploaded", fields: [uploadedById], references: [id])

  @@index([assignmentId, createdAt])
  @@index([uploadedById, createdAt])
}


model Subject {
  id                   String                    @id @default(cuid())
  code                 String                    @unique // e.g. "MATH", "ENG", "SOC"
  name                 String
  active               Boolean                   @default(true)
  students             StudentSubject[]
  paces                PaceRecord[]
  progress             PaceProgress[]
  advancementApprovals PaceAdvancementApproval[]
  paceInventoryOrders  PaceInventoryOrder[]
  diagnosticResults    DiagnosticResult[]
}

model StudentSubject {
  id                String  @id @default(cuid())
  studentId         String
  subjectId         String
  currentPaceNumber Int     @default(1001)
  student           Student @relation(fields: [studentId], references: [id])
  subject           Subject @relation(fields: [subjectId], references: [id])

  @@unique([studentId, subjectId])
}

model YearGroupBand {
  id            String       @id @default(cuid())
  name          String       @unique
  standardYears String[]     @default([])
  active        Boolean      @default(true)
  sortOrder     Int          @default(0)
  colour        String
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  staffShifts   StaffShift[]
  homeworkAssignments HomeworkAssignmentBand[]

  @@index([active, sortOrder])
}

model PaceRecord {
  id            String    @id @default(cuid())
  studentId     String
  subjectId     String
  paceNumber    Int
  selfTestScore Float?
  paceTestScore Float?
  completedAt   DateTime?
  recordedById  String
  createdAt     DateTime  @default(now())

  student               Student                  @relation(fields: [studentId], references: [id])
  subject               Subject                  @relation(fields: [subjectId], references: [id])
  recordedBy            User                     @relation("RecordedPace", fields: [recordedById], references: [id])
  completedPaceProgress PaceProgress[]           @relation("PaceProgressCompletedByRecord")
  advancementApproval   PaceAdvancementApproval? @relation("PaceAdvancementApprovalRecord")
  automaticMeritEntries BehaviourEntry[]         @relation("PaceRecordAutomaticMerit")

  @@index([studentId, subjectId])
}

model PaceProgress {
  id                    String    @id @default(cuid())
  studentId             String
  subjectId             String
  paceNumber            Int
  startedAt             DateTime
  completedAt           DateTime?
  completedByRecordId   String?
  completedByApprovalId String?
  finalTestAttempts     Int       @default(0)
  createdAt             DateTime  @default(now())
