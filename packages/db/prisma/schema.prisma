  postedBy    User                    @relation("NoticesPosted", fields: [postedById], references: [id])
  reads       StaffNoticeRead[]
  attachments StaffNoticeAttachment[]

  @@index([active, expiresAt, createdAt])
  @@index([audience, active, expiresAt, createdAt])
}

model StaffNoticeAttachment {
  id                  String   @id @default(cuid())
  noticeId            String
  originalFileNameEnc String
  mimeType            String
  sizeBytes           Int
  storageBucket       String
  storagePathEnc      String
  position            Int
