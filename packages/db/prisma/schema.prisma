// ---------------------------------------------------------------------------
// Attendance & behaviour
// ---------------------------------------------------------------------------

enum AttendanceStatus {
  Present
  Absent
  Late
}

enum AbsenceReason {
  Sick
  Holiday
  NotScheduled
  Excused
  Unexcused
}

enum SpecialAttendanceRegister {
  FieldTrip
  MinibusInbound
  MinibusOutbound
  TheCedars
}

model Attendance {
  id            String           @id @default(cuid())
  studentId     String
  date          DateTime         @db.Date
  status        AttendanceStatus
  absenceReason AbsenceReason?
  recordedById  String
  createdAt     DateTime         @default(now())

  student    Student @relation(fields: [studentId], references: [id])
  recordedBy User    @relation("RecordedAttendance", fields: [recordedById], references: [id])

  @@unique([studentId, date])
  @@index([date])
}

model StaffAttendance {
  id            String           @id @default(cuid())
  staffUserId   String
  date          DateTime         @db.Date
  status        AttendanceStatus
  absenceReason AbsenceReason?
  recordedById  String
  createdAt     DateTime         @default(now())

  staffUser  User @relation("StaffAttendanceUser", fields: [staffUserId], references: [id])
  recordedBy User @relation("RecordedStaffAttendance", fields: [recordedById], references: [id])

  @@unique([staffUserId, date])
  @@index([date])
}

model SpecialAttendanceSession {
  id             String                    @id @default(cuid())
  date           DateTime                  @db.Date
  register       SpecialAttendanceRegister
  destinationEnc String?
  createdById    String
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  createdBy User                      @relation("SpecialAttendanceSessionsCreated", fields: [createdById], references: [id])
  records   SpecialAttendanceRecord[]

  @@unique([date, register])
  @@index([register, date])
  @@index([createdById])
}

model SpecialAttendanceRecord {
  id           String           @id @default(cuid())
  sessionId    String
  studentId    String
  status       AttendanceStatus
  recordedById String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  session    SpecialAttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student    Student                  @relation(fields: [studentId], references: [id])
  recordedBy User                     @relation("RecordedSpecialAttendance", fields: [recordedById], references: [id])

  @@unique([sessionId, studentId])
  @@index([studentId])
  @@index([recordedById])
}

model StaffAvailabilityWindow {
  id          String   @id @default(cuid())
  staffUserId String
  dayOfWeek   Int
  startMinute Int
  endMinute   Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  staffUser User @relation("StaffAvailability", fields: [staffUserId], references: [id])

  @@index([staffUserId, dayOfWeek])
}

model StaffMonthlyAvailabilityWindow {
  id          String   @id @default(cuid())
  staffUserId String
  date        DateTime @db.Date
  startMinute Int
  endMinute   Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  staffUser User @relation("StaffMonthlyAvailability", fields: [staffUserId], references: [id])

  @@index([staffUserId, date])
  @@index([date])
}

model ParentVolunteerDay {
  id           String   @id @default(cuid())
  parentUserId String
  date         DateTime @db.Date
  placement    ParentVolunteerPlacement
  slot         Int      @db.SmallInt
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  parentUser User @relation("ParentVolunteerDays", fields: [parentUserId], references: [id])

  @@unique([parentUserId, date, placement])
  @@unique([date, placement, slot])
  @@index([date, placement])
}

enum ParentVolunteerPlacement {
  Centre
  LunchAndClubsPrimary
  LunchAndClubsSecondary
}

enum StaffShiftKind {
  Cover
  Meeting
}

model StaffShift {
  id              String         @id @default(cuid())
  staffUserId     String
  kind            StaffShiftKind @default(Cover)
  yearGroupBandId String?
  date            DateTime       @db.Date
  startsAt        DateTime
  endsAt          DateTime
  notes           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  staffUser        User               @relation("StaffShifts", fields: [staffUserId], references: [id])
  yearGroupBand    YearGroupBand?     @relation(fields: [yearGroupBandId], references: [id])
  fromSwapRequests ShiftSwapRequest[] @relation("FromShift")
  toSwapRequests   ShiftSwapRequest[] @relation("ToShift")

  @@index([staffUserId, date])
  @@index([yearGroupBandId, date])
}

enum ShiftSwapStatus {
  Pending
  Approved
  Rejected
}

model ShiftSwapRequest {
  id              String          @id @default(cuid())
  requesterUserId String
  targetUserId    String
  fromShiftId     String
  toShiftId       String
  status          ShiftSwapStatus @default(Pending)
  approvedById    String?
  reviewedAt      DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  requester  User       @relation("RequestedShiftSwaps", fields: [requesterUserId], references: [id])
  targetUser User       @relation("TargetedShiftSwaps", fields: [targetUserId], references: [id])
  approvedBy User?      @relation("ApprovedShiftSwaps", fields: [approvedById], references: [id])
  fromShift  StaffShift @relation("FromShift", fields: [fromShiftId], references: [id])
  toShift    StaffShift @relation("ToShift", fields: [toShiftId], references: [id])

  @@index([requesterUserId, status])
  @@index([targetUserId, status])
  @@index([fromShiftId, status])
  @@index([toShiftId, status])
}

enum BehaviourType {
  Merit
  Demerit
  General
}

enum BehaviourVisibility {
  General
  Sensitive
}

enum MessageThreadKind {
  ParentStaff
  SupervisorHead
  StaffDirect
  Staffroom
  StudentDirect
}

model BehaviourEntry {
  id             String              @id @default(cuid())
  clubId         String?
  studentId      String
  type           BehaviourType
  category       String
  // note is free text PII — encrypted at rest (ADR-005)
  noteEnc        String?
  visibility     BehaviourVisibility @default(General)
  // Merit: positive N. Demerit: negative selected value. General: 0.
  meritDelta     Int
  recordedById   String
  paceRecordId   String?
  deletedAt      DateTime?
  deletedById    String?
  seenAt         DateTime?
  seenById       String?
  headCommentEnc String?
  createdAt      DateTime            @default(now())

  club       Club?         @relation(fields: [clubId], references: [id], onDelete: SetNull)
  student    Student       @relation(fields: [studentId], references: [id])
  recordedBy User          @relation("RecordedBehaviour", fields: [recordedById], references: [id])
  deletedBy  User?         @relation("DeletedBehaviour", fields: [deletedById], references: [id], onDelete: SetNull)
  seenBy     User?         @relation("SeenBehaviour", fields: [seenById], references: [id], onDelete: SetNull)
  paceRecord PaceRecord?   @relation("PaceRecordAutomaticMerit", fields: [paceRecordId], references: [id], onDelete: SetNull)
  ledgerRows MeritLedger[]
  homeworkSubmission HomeworkSubmission? @relation("HomeworkSubmissionBehaviour")

  @@index([clubId, createdAt])
  @@index([studentId, createdAt])
  @@index([visibility])
  @@index([paceRecordId])
  @@index([deletedAt])
  @@index([deletedById])
  @@index([seenAt])
  @@index([seenById])
}

model DemeritStageOverride {
  id        String   @id @default(cuid())
  studentId String
  // Local calendar day key in Europe/London, formatted as YYYY-MM-DD.
  day       String
  stage     Int
  noteEnc   String?
  setById   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id])
  setBy   User    @relation("DemeritStageOverridesSet", fields: [setById], references: [id])

  @@unique([studentId, day])
  @@index([day, stage])
  @@index([setById, createdAt])
}

model ChildNote {
  id             String    @id @default(cuid())
  studentId      String
  noteEnc        String
  sensitive      Boolean   @default(false)
  createdById    String
  deletedAt      DateTime?
  deletedById    String?
  seenAt         DateTime?
  seenById       String?
  headCommentEnc String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  student   Student @relation(fields: [studentId], references: [id])
  createdBy User    @relation("ChildNotesCreated", fields: [createdById], references: [id])
  deletedBy User?   @relation("DeletedChildNotes", fields: [deletedById], references: [id], onDelete: SetNull)
  seenBy    User?   @relation("SeenChildNotes", fields: [seenById], references: [id], onDelete: SetNull)

  @@index([studentId, createdAt])
  @@index([sensitive])
  @@index([createdById, createdAt])
  @@index([deletedAt])
  @@index([deletedById])
  @@index([seenAt])
  @@index([seenById])
}

// ---------------------------------------------------------------------------
// Merit economy (three-account double-entry ledger)
// ---------------------------------------------------------------------------

enum MeritAccount {
  Spend
  Saving
  Investment
  InvestmentReturn
  TithePaid
  Given
  FeeSink
  TaxSink
  ShopReserved
}

model MeritLedger {
  id             String       @id @default(cuid())
  studentId      String
  account        MeritAccount
  delta          Int // signed integer merits
  reason         String
  relatedEntryId String?
  createdAt      DateTime     @default(now())

  student      Student         @relation(fields: [studentId], references: [id])
  relatedEntry BehaviourEntry? @relation(fields: [relatedEntryId], references: [id])

  @@index([studentId, account])
  @@index([studentId, createdAt])
}

model TitheConfig {
  studentId   String    @id
  percentage  Int       @default(10)
  cadence     String    @default("Weekly") // Weekly | Monthly
  mode        String    @default("Percentage") // Percentage | FixedAmount
  fixedAmount Int?
  weeklyDay   Int       @default(5) // 0 Sunday through 6 Saturday
  monthlyDate Int       @default(1)
  lastRunAt   DateTime?

  student Student @relation(fields: [studentId], references: [id])
}

model TitheRun {
  id            String   @id @default(cuid())
  studentId     String
  cadence       String   @default("Weekly")
  periodStart   DateTime
  periodEnd     DateTime
  grossMerits   Int
  minimumAmount Int      @default(0)
  titheAmount   Int
  createdAt     DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id])

  @@unique([studentId, cadence, periodStart])
}

model SavingsInterestRun {
  id             String   @id @default(cuid())
  studentId      String
  periodStart    DateTime
  periodEnd      DateTime
  savingBalance  Int
  interestAmount Int
  createdAt      DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id])

  @@unique([studentId, periodStart])
}

model InvestmentAccount {
  studentId String  @id
  units     Decimal @default(0) @db.Decimal(18, 6)

  student Student @relation(fields: [studentId], references: [id])
}

model InvestmentNav {
  date        DateTime @id @db.Date
  nav         Decimal  @db.Decimal(18, 6)
  dailyReturn Decimal  @db.Decimal(10, 6)
}

model InvestmentInstrument {
  id             String   @id @default(cuid())
  symbol         String
  provider       String
  providerSymbol String
  displayName    String
  kind           String
  exchangeMic    String
  sourceCurrency String
  riskBand       String
  category       String?
  summary        String?
  themeColor     String?
  newsSymbol     String?
  dividendSymbol String?
  enabled        Boolean  @default(true)
  sortOrder      Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  snapshots MarketDataSnapshot[]
  holdings  InvestmentHolding[]
  tx        InvestmentTransaction[]
  news      InvestmentNewsItem[]
  dividends InvestmentDividendEvent[]

  @@unique([provider, providerSymbol])
  @@index([enabled, sortOrder])
  @@index([symbol])
}

model InvestmentHolding {
  id              String   @id @default(cuid())
  studentId       String
  instrumentId    String
  units           Decimal  @default(0) @db.Decimal(18, 6)
  costBasisMerits Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  student    Student              @relation(fields: [studentId], references: [id])
  instrument InvestmentInstrument @relation(fields: [instrumentId], references: [id], onDelete: Restrict)

  @@unique([studentId, instrumentId])
  @@index([studentId])
  @@index([instrumentId])
}

model MarketDataSnapshot {
  id                  String   @id @default(cuid())
  instrumentId        String
  provider            String
  providerTimestamp   DateTime
  serverFetchedAt     DateTime
  sourceCurrency      String
  sourcePrice         Decimal  @db.Decimal(18, 6)
  gbpConversionRate   Decimal  @db.Decimal(18, 6)
  gbpPrice            Decimal  @db.Decimal(18, 6)
  previousCloseGbp    Decimal  @db.Decimal(18, 6)
  dayChangePct        Decimal  @db.Decimal(10, 6)
  rawPayloadHash      String
  providerCreditsUsed Int?
  providerCreditsLeft Int?
  createdAt           DateTime @default(now())

  instrument InvestmentInstrument @relation(fields: [instrumentId], references: [id], onDelete: Restrict)

  @@index([instrumentId, serverFetchedAt])
  @@index([provider, providerTimestamp])
}

enum InvestmentTxType {
  Buy
  Sell
  Dividend
}

model InvestmentTransaction {
  id        String           @id @default(cuid())
  studentId String
  type      InvestmentTxType
  instrumentId    String?
  units     Decimal          @db.Decimal(18, 6)
  nav       Decimal          @db.Decimal(18, 6)
  feeMerits Int              @default(0)
  grossMerits     Int?
  taxMerits       Int        @default(0)
  costBasisMerits Int?
  createdAt DateTime         @default(now())

  student    Student               @relation(fields: [studentId], references: [id])
  instrument InvestmentInstrument? @relation(fields: [instrumentId], references: [id], onDelete: Restrict)
  dividendPayments InvestmentDividendPayment[]

  @@index([studentId, createdAt])
  @@index([instrumentId])
}

model InvestmentNewsItem {
  id             String   @id @default(cuid())
  instrumentId   String
  provider       String
  providerNewsId String
  headline       String
  summary        String   @default("")
  source         String
  url            String
  imageUrl       String?
  publishedAt    DateTime
  createdAt      DateTime @default(now())

  instrument InvestmentInstrument @relation(fields: [instrumentId], references: [id], onDelete: Restrict)

  @@unique([provider, providerNewsId])
  @@index([instrumentId, publishedAt])
}

model InvestmentDividendEvent {
  id                String   @id @default(cuid())
  instrumentId      String
  provider          String
  providerEventId   String
  exDate            DateTime @db.Date
  payDate           DateTime? @db.Date
  sourceCurrency    String
  amountSource      Decimal  @db.Decimal(18, 6)
  gbpConversionRate Decimal  @db.Decimal(18, 6)
  amountGbp         Decimal  @db.Decimal(18, 6)
  amountMerits      Decimal  @db.Decimal(18, 6)
  createdAt         DateTime @default(now())

  instrument InvestmentInstrument @relation(fields: [instrumentId], references: [id], onDelete: Restrict)
  payments   InvestmentDividendPayment[]

  @@unique([provider, providerEventId])
  @@unique([instrumentId, exDate, amountSource])
  @@index([instrumentId, exDate])
}

model InvestmentDividendPayment {
  id              String   @id @default(cuid())
  studentId       String
  dividendEventId String
  transactionId   String
  units           Decimal  @db.Decimal(18, 6)
  payoutMerits    Int
  createdAt       DateTime @default(now())

  student       Student                 @relation(fields: [studentId], references: [id], onDelete: Restrict)
  dividendEvent InvestmentDividendEvent @relation(fields: [dividendEventId], references: [id], onDelete: Restrict)
  transaction   InvestmentTransaction   @relation(fields: [transactionId], references: [id], onDelete: Restrict)

  @@unique([studentId, dividendEventId])
  @@index([dividendEventId])
  @@index([transactionId])
}

model CharityPot {
  id          String   @id
  goalMerits  Int      @default(0)
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  updatedBy User? @relation("CharityPotUpdated", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([updatedById])
}

// ---------------------------------------------------------------------------
// Shop (in-app)
// ---------------------------------------------------------------------------

enum ShopCategory {
  Treats
  Privileges
  Stationery
  Accessories
  Toys
  Vouchers
  Merch
  Recognition
}

enum ShopReservationStatus {
  Ready
  Collected
  Cancelled
}

model ShopItem {
  id                String       @id @default(cuid())
  name              String
  photoUrl          String?
  category          ShopCategory @default(Treats)
  blurb             String?
  description       String?
  priceExVat        Int // merits, VAT-exclusive
  vatRatePct        Int          @default(20)
  priceIncVat       Int // merits, VAT-inclusive (derived but stored for auditability)
  stockCount        Int          @default(0)
  lowStockThreshold Int          @default(5)
  active            Boolean      @default(true)
  createdById       String
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  createdBy        User                  @relation("ShopItemsCreated", fields: [createdById], references: [id])
  purchases        ShopPurchase[]
  reservationLines ShopReservationLine[]

  @@index([active])
  @@index([category, active])
}

model ShopPurchase {
  id               String   @id @default(cuid())
  studentId        String
  itemId           String
  unitsBought      Int
  totalPriceMerits Int
  shopkeeperId     String
  createdAt        DateTime @default(now())

  student    Student  @relation(fields: [studentId], references: [id])
  item       ShopItem @relation(fields: [itemId], references: [id])
  shopkeeper User     @relation("Shopkeeper", fields: [shopkeeperId], references: [id])

  @@index([studentId, createdAt])
  @@index([itemId, createdAt])
}

model ShopReservation {
  id               String                @id @default(cuid())
  studentId        String
  reservedById     String
  status           ShopReservationStatus @default(Ready)
  totalPriceMerits Int
  collectedAt      DateTime?
  collectedById    String?
  cancelledAt      DateTime?
  cancelledById    String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  student     Student               @relation(fields: [studentId], references: [id])
  reservedBy  User                  @relation("ShopReservationCreator", fields: [reservedById], references: [id])
  collectedBy User?                 @relation("ShopReservationCollector", fields: [collectedById], references: [id])
  cancelledBy User?                 @relation("ShopReservationCanceller", fields: [cancelledById], references: [id])
  lines       ShopReservationLine[]

  @@index([status, createdAt])
  @@index([studentId, status])
  @@index([reservedById, createdAt])
  @@index([collectedById])
  @@index([cancelledById])
}

model ShopReservationLine {
  id               String   @id @default(cuid())
  reservationId    String
  itemId           String
  unitsReserved    Int
  unitPriceMerits  Int
  totalPriceMerits Int
  createdAt        DateTime @default(now())

  reservation ShopReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  item        ShopItem        @relation(fields: [itemId], references: [id])

  @@index([reservationId])
  @@index([itemId])
}

