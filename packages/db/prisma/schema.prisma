// ---------------------------------------------------------------------------
// Permission slips
// ---------------------------------------------------------------------------

enum PermissionSlipCategory {
  SchoolTrip
  Activity
  Reward
  Consent
}

enum PermissionSlipResponseStatus {
  Pending
  Signed
  Declined
}

enum PermissionSlipSignatureSource {
  ParentPortal
  Physical
}

enum PermissionSlipPaymentStatus {
  NotRequired
  Unpaid
  PaymentPending
  Paid
}

model PermissionSlip {
  id                      String                 @id @default(cuid())
  title                   String
  category                PermissionSlipCategory
  descriptionEnc          String?
  eventDate               DateTime?              @db.Date
  deadline                DateTime               @db.Date
  departureTimeMinutes    Int?
  returnTimeMinutes       Int?
  locationEnc             String?
  transportEnc            String?
  costEnc                 String?
  consentTextEnc          String
  requireMedical          Boolean                @default(false)
  requireEmergencyContact Boolean                @default(false)
  requirePayment          Boolean                @default(false)
  recipientLabel          String
  active                  Boolean                @default(true)
  calendarEventId         String?                @unique
  createdById             String
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt

  calendarEvent CalendarEvent?            @relation(fields: [calendarEventId], references: [id], onDelete: SetNull)
  createdBy     User                      @relation("PermissionSlipsCreated", fields: [createdById], references: [id])
  recipients    PermissionSlipRecipient[]
  bringItems    PermissionSlipBringItem[]
  questions     PermissionSlipQuestion[]

  @@index([active, deadline])
  @@index([createdById, createdAt])
  @@index([category, active, deadline])
}

model PermissionSlipRecipient {
  slipId               String
  studentId            String
  position             Int
  responseStatus       PermissionSlipResponseStatus   @default(Pending)
  signatureSource      PermissionSlipSignatureSource?
  parentNameEnc        String?
  signedAt             DateTime?
  medicalInfoEnc       String?
  emergencyContactEnc  String?
  declineReasonEnc     String?
  parentRespondedById  String?
  physicalSignedById   String?
  paymentStatus        PermissionSlipPaymentStatus    @default(NotRequired)
  parentMarkedPaidAt   DateTime?
  parentMarkedPaidById String?
  paymentConfirmedAt   DateTime?
  paymentConfirmedById String?
  createdAt            DateTime                       @default(now())
  updatedAt            DateTime                       @updatedAt

  slip               PermissionSlip         @relation(fields: [slipId], references: [id], onDelete: Cascade)
  student            Student                @relation(fields: [studentId], references: [id])
  parentRespondedBy  User?                  @relation("PermissionSlipParentResponses", fields: [parentRespondedById], references: [id], onDelete: SetNull)
  physicalSignedBy   User?                  @relation("PermissionSlipPhysicalSignatures", fields: [physicalSignedById], references: [id], onDelete: SetNull)
  parentMarkedPaidBy User?                  @relation("PermissionSlipPaymentsMarked", fields: [parentMarkedPaidById], references: [id], onDelete: SetNull)
  paymentConfirmedBy User?                  @relation("PermissionSlipPaymentsConfirmed", fields: [paymentConfirmedById], references: [id], onDelete: SetNull)
  answers            PermissionSlipAnswer[]

  @@id([slipId, studentId])
  @@unique([slipId, position])
  @@index([studentId, responseStatus])
  @@index([paymentStatus, parentMarkedPaidAt])
  @@index([parentRespondedById, signedAt])
  @@index([physicalSignedById, signedAt])
  @@index([parentMarkedPaidById, parentMarkedPaidAt])
  @@index([paymentConfirmedById, paymentConfirmedAt])
}

model PermissionSlipBringItem {
  id        String   @id @default(cuid())
  slipId    String
  position  Int
  labelEnc  String
  createdAt DateTime @default(now())

  slip PermissionSlip @relation(fields: [slipId], references: [id], onDelete: Cascade)

  @@unique([slipId, position])
  @@index([slipId])
}

model PermissionSlipQuestion {
  id        String   @id @default(cuid())
  slipId    String
  position  Int
  labelEnc  String
  required  Boolean  @default(true)
  createdAt DateTime @default(now())

  slip    PermissionSlip         @relation(fields: [slipId], references: [id], onDelete: Cascade)
  answers PermissionSlipAnswer[]

  @@unique([slipId, position])
  @@index([slipId])
}

model PermissionSlipAnswer {
  questionId String
  slipId     String
  studentId  String
  answerEnc  String
  createdAt  DateTime @default(now())

  question  PermissionSlipQuestion  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  recipient PermissionSlipRecipient @relation(fields: [slipId, studentId], references: [slipId, studentId], onDelete: Cascade)

  @@id([questionId, studentId])
  @@index([slipId, studentId])
}

// ---------------------------------------------------------------------------
// Incident reports
// ---------------------------------------------------------------------------

enum IncidentType {
  SafeguardingConcern
  AccidentFirstAid
  BehaviourIncident
  BullyingPeerOnPeer
  OnlineSafety
  MedicalMedication
  PhysicalIntervention
  NearMiss
  OffSiteTrip
}

enum IncidentSeverity {
  Low
  Medium
  High
  Critical
}

enum IncidentConfidentiality {
  StaffOnly
  HeadDsl
  ParentViewableAfterSignOff
}

enum IncidentReportStatus {
  Draft
  HeadReview
  Escalated
  SignedOff
  Archived
}

enum IncidentParentCopyStatus {
  Draft
  Generated
  Shared
  Archived
}

enum IncidentPersonKind {
  StaffInvolved
  Witness
}

enum IncidentEventType {
  DraftSaved
  SubmittedForHeadReview
  SignedOff
  Escalated
  ParentCopyGenerated
  ParentCopyShared
  ParentCopyAcknowledged
  AttachmentAdded
  Archived
}

model IncidentReport {
  id                         String                  @id @default(cuid())
  reportNumber               String                  @unique
  type                       IncidentType
  severity                   IncidentSeverity
  confidentiality            IncidentConfidentiality @default(StaffOnly)
  status                     IncidentReportStatus    @default(Draft)
  occurredAt                 DateTime
  locationEnc                String
  activityEnc                String?
  offSite                    Boolean                 @default(false)
  factualAccountEnc          String
  directDisclosureEnc        String?
  immediateActionsEnc        String?
  witnessesEnc               String?
  injurySustained            Boolean                 @default(false)
  bodyAreaEnc                String?
  firstAidGiven              Boolean                 @default(false)
  firstAiderId               String?
  emergencyServicesContacted Boolean                 @default(false)
  hospitalTreatment          Boolean                 @default(false)
  parentCarerNotified        Boolean                 @default(false)
  parentNotifiedAt           DateTime?
  medicalNotesEnc            String?
  dslNotified                Boolean                 @default(false)
  headSignOffRequired        Boolean                 @default(false)
  pastorPrincipalEscalation  Boolean                 @default(false)
  ladoConsidered             Boolean                 @default(false)
  socialCarePoliceReferral   Boolean                 @default(false)
  riddorCheck                Boolean                 @default(false)
  dataSharingReasonEnc       String?
  parentVisibilityRequested  Boolean                 @default(false)
  recordedById               String
  signedOffById              String?
  signedOffAt                DateTime?
  escalatedById              String?
  escalatedAt                DateTime?
  archivedAt                 DateTime?
  createdAt                  DateTime                @default(now())
  updatedAt                  DateTime                @updatedAt

  recordedBy   User                       @relation("IncidentReportsRecorded", fields: [recordedById], references: [id])
  signedOffBy  User?                      @relation("IncidentReportsSignedOff", fields: [signedOffById], references: [id], onDelete: SetNull)
  escalatedBy  User?                      @relation("IncidentReportsEscalated", fields: [escalatedById], references: [id], onDelete: SetNull)
  firstAider   User?                      @relation("IncidentReportsFirstAided", fields: [firstAiderId], references: [id], onDelete: SetNull)
  students     IncidentReportStudent[]
  staff        IncidentReportStaff[]
  attachments  IncidentReportAttachment[]
  parentCopies IncidentReportParentCopy[]
  events       IncidentReportEvent[]

  @@index([status, updatedAt])
  @@index([type, severity, occurredAt])
  @@index([recordedById, createdAt])
  @@index([signedOffById, signedOffAt])
  @@index([escalatedById, escalatedAt])
}

model IncidentReportStudent {
  reportId  String
  studentId String
  position  Int
  createdAt DateTime @default(now())

  report  IncidentReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  student Student        @relation(fields: [studentId], references: [id])

  @@id([reportId, studentId])
  @@unique([reportId, position])
  @@index([studentId])
}

model IncidentReportStaff {
