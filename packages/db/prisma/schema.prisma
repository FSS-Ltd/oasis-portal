  club       Club @relation(fields: [clubId], references: [id])
  user       User @relation("ClubLeadAssignedUsers", fields: [userId], references: [id])
  assignedBy User @relation("ClubLeadAssignmentsMade", fields: [assignedById], references: [id])

  @@unique([clubId, userId])
  @@index([userId])
  @@index([assignedById])
}

model ClubRotaParticipant {
  id           String   @id @default(cuid())
  clubId       String
