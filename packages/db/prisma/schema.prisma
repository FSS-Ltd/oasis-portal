  message CommunityMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  student Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([messageId, studentId])
  @@index([studentId, readAt])
}

// ---------------------------------------------------------------------------
// Reports
// ---------------------------------------------------------------------------

enum TermReportStatus {
  Draft
  UnderReview
  Sent
}

enum ReportPeriodType {
  Term
  AcademicYear
  Custom
}

model TermReport {
  id              String            @id @default(cuid())
  studentId       String
  periodKey       String            @map("term")
  periodType      ReportPeriodType
  periodLabel     String
  periodStart     DateTime          @db.Date
  periodEnd       DateTime          @db.Date
  status          TermReportStatus  @default(Draft)
  // Snapshot of compiled data at send time (encrypted — contains PII)
  compiledJsonEnc String
  pdfBytesEnc     String?
  pdfFileNameEnc  String?
  pdfGeneratedAt  DateTime?
  sentAt          DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  student Student @relation(fields: [studentId], references: [id])

  @@unique([studentId, periodKey], map: "TermReport_studentId_term_key")
}

// ---------------------------------------------------------------------------
// School fee invoices
// ---------------------------------------------------------------------------

enum SchoolFeeInvoiceStatus {
  Draft
  Unpaid
  PaymentPending
  Paid
}

enum SchoolFeeBillingCadence {
  Annual
  Term
  Monthly
}

enum SchoolFeeInvoiceDiscountKind {
  Preset
  ManualPercent
  ManualFixed
}

enum SchoolFeeInvoiceKind {
  SchoolFee
  Manual
}

model SchoolFeeYearFeeConfig {
  id                 String   @id @default(cuid())
  schoolYear         Int      @unique
  annualAmountPence  Int
  termAmountPence    Int
  monthlyAmountPence Int
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model SchoolFeeInvoice {
  id                     String                   @id @default(cuid())
  invoiceNumber          String?                  @unique
  studentId              String?
  status                 SchoolFeeInvoiceStatus   @default(Draft)
  kind                   SchoolFeeInvoiceKind     @default(SchoolFee)
  invoiceTitleEnc        String?
  schoolYear             Int?
  billingCadence         SchoolFeeBillingCadence?
  familyLabelEnc         String?
  term                   String?
  issuedOn               DateTime?                @db.Date
  dueOn                  DateTime?                @db.Date
  paidAt                 DateTime?
  subtotalAmountPence    Int                      @default(0)
  discountAmountPence    Int                      @default(0)
  totalAmountPence       Int                      @default(0)
  discountExplanationEnc String?
  originalFileNameEnc    String
  fileMimeType           String                   @default("application/pdf")
  fileSizeBytes          Int
  pdfBytesEnc            String
  extractedTextEnc       String?
  createdById            String
  parentMarkedPaidAt     DateTime?
  parentMarkedPaidById   String?
  paymentConfirmedAt     DateTime?
  paymentConfirmedById   String?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt

  student            Student?                   @relation(fields: [studentId], references: [id])
  createdBy          User                       @relation("SchoolFeeInvoicesCreated", fields: [createdById], references: [id])
  parentMarkedPaidBy User?                      @relation("SchoolFeeInvoicesParentMarkedPaid", fields: [parentMarkedPaidById], references: [id], onDelete: SetNull)
  paymentConfirmedBy User?                      @relation("SchoolFeeInvoicesPaymentConfirmed", fields: [paymentConfirmedById], references: [id], onDelete: SetNull)
  lineItems          SchoolFeeInvoiceLineItem[]
  students           SchoolFeeInvoiceStudent[]
  discounts          SchoolFeeInvoiceDiscount[]

  @@index([studentId, status, dueOn])
  @@index([schoolYear, status, dueOn])
  @@index([status, dueOn])
  @@index([createdById, createdAt])
  @@index([parentMarkedPaidById, parentMarkedPaidAt])
  @@index([paymentConfirmedById, paymentConfirmedAt])
}

model SchoolFeeInvoiceLineItem {
  id               String   @id @default(cuid())
  invoiceId        String
  position         Int
  descriptionEnc   String
  quantity         Int
  unitAmountPence  Int
  totalAmountPence Int
  createdAt        DateTime @default(now())

  invoice SchoolFeeInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([invoiceId, position])
  @@index([invoiceId])
}

model SchoolFeeInvoiceStudent {
  invoiceId String
  studentId String
  position  Int
  createdAt DateTime @default(now())

  invoice SchoolFeeInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  student Student          @relation(fields: [studentId], references: [id])

  @@id([invoiceId, studentId])
  @@unique([invoiceId, position])
  @@index([studentId])
}

model SchoolFeeInvoiceDiscount {
  id                 String                       @id @default(cuid())
  invoiceId          String
  position           Int
  labelEnc           String
  kind               SchoolFeeInvoiceDiscountKind
  presetCode         String?
  percentBps         Int?
  amountPence        Int?
  baseAmountPence    Int                          @default(0)
  appliedAmountPence Int                          @default(0)
  optedOutAt         DateTime?
  optedOutById       String?
  createdAt          DateTime                     @default(now())

  invoice    SchoolFeeInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  optedOutBy User?            @relation("SchoolFeeDiscountOptedOutBy", fields: [optedOutById], references: [id], onDelete: SetNull)

  @@unique([invoiceId, position])
  @@index([invoiceId])
  @@index([optedOutById, optedOutAt])
}

// ---------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------

enum AuditAction {
  Create
  Update
  Delete
  DecryptSensitive
  DecryptPii
  ReadSensitive
  Login
  Login2FA
  PermissionDenied
}

model AuditLog {
  id        String      @id @default(cuid())
  userId    String?
  action    AuditAction
  entity    String
  entityId  String?
  meta      Json?
  createdAt DateTime    @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([entity, entityId])
}
