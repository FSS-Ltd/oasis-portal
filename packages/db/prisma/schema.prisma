// Oasis Learning Centre — Prisma schema v1
// See oasis-platform-plan.md (§Data model) and docs/ADRs/004, 005.
// PII fields are stored as application-layer ciphertext (see src/encryption.ts);
// suffix `Enc` indicates an encrypted column. Sibling `_bidx` columns hold
// HMAC blind indexes for equality lookups.

generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native", "rhel-openssl-3.0.x"]
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Identity & access
// ---------------------------------------------------------------------------

enum Role {
  Head
  Principal
  Pastor
  HeadOfDiscipline
  TechnicalSupport
  ClubsAdmin
  ClubsLead
  Supervisor
  Parent
  Student
}

enum UserInvitationStatus {
  Pending
  Accepted
}

enum UserInvitationEmailStatus {
  NotSent
  Sent
  Failed
}

enum ChildRegistrationPromptStatus {
  Unanswered
  NoChildren
  HasChildren
}

model User {
  id                                String                        @id @default(cuid())
  clerkId                           String                        @unique
  role                              Role
  tags                              String[]                      @default([])
  childRegistrationPromptStatus     ChildRegistrationPromptStatus @default(Unanswered)
  childRegistrationPromptAnsweredAt DateTime?
  // --- PII (encrypted, ADR-005) ---
  fullNameEnc                       String
  emailEnc                          String
  emailBidx                         String                        @unique
  dobEnc                            String?
  phoneEnc                          String?
  addressEnc                        String?
  // --- operational ---
  active                            Boolean                       @default(true)
  createdAt                         DateTime                      @default(now())
  updatedAt                         DateTime                      @updatedAt

  guardianOf                       Guardian[]
  studentProfile                   Student?                         @relation("StudentLogin")
  behaviourEntries                 BehaviourEntry[]                 @relation("RecordedBehaviour")
  childNotesCreated                ChildNote[]                      @relation("ChildNotesCreated")
  deletedBehaviourEntries          BehaviourEntry[]                 @relation("DeletedBehaviour")
  deletedChildNotes                ChildNote[]                      @relation("DeletedChildNotes")
  seenBehaviourEntries             BehaviourEntry[]                 @relation("SeenBehaviour")
  seenChildNotes                   ChildNote[]                      @relation("SeenChildNotes")
  paceRecords                      PaceRecord[]                     @relation("RecordedPace")
  approvedPaceAdvancements         PaceAdvancementApproval[]        @relation("ApprovedPaceAdvancements")
  attendanceRecords                Attendance[]                     @relation("RecordedAttendance")
  availabilityWindows              StaffAvailabilityWindow[]        @relation("StaffAvailability")
  monthlyAvailabilityWindows       StaffMonthlyAvailabilityWindow[] @relation("StaffMonthlyAvailability")
  staffShifts                      StaffShift[]                     @relation("StaffShifts")
  requestedShiftSwaps              ShiftSwapRequest[]               @relation("RequestedShiftSwaps")
  targetedShiftSwaps               ShiftSwapRequest[]               @relation("TargetedShiftSwaps")
  approvedShiftSwaps               ShiftSwapRequest[]               @relation("ApprovedShiftSwaps")
  staffAttendance                  StaffAttendance[]                @relation("StaffAttendanceUser")
  recordedStaffAttendance          StaffAttendance[]                @relation("RecordedStaffAttendance")
  noticesPosted                    StaffNotice[]                    @relation("NoticesPosted")
  noticeReads                      StaffNoticeRead[]
  calendarEventsCreated            CalendarEvent[]                  @relation("CalendarEventsCreated")
  requiredCalendarEvents           CalendarEventRequiredPerson[]    @relation("CalendarEventRequiredUser")
  calendarEventTagsCreated         CalendarEventRequiredPerson[]    @relation("CalendarEventRequiredTaggedBy")
  permissionSlipsCreated           PermissionSlip[]                 @relation("PermissionSlipsCreated")
  permissionSlipResponses          PermissionSlipRecipient[]        @relation("PermissionSlipParentResponses")
  permissionSlipPhysicalSignatures PermissionSlipRecipient[]        @relation("PermissionSlipPhysicalSignatures")
  permissionSlipPaymentsMarked     PermissionSlipRecipient[]        @relation("PermissionSlipPaymentsMarked")
  permissionSlipPaymentsConfirmed  PermissionSlipRecipient[]        @relation("PermissionSlipPaymentsConfirmed")
  incidentReportsRecorded          IncidentReport[]                 @relation("IncidentReportsRecorded")
  incidentReportsSignedOff         IncidentReport[]                 @relation("IncidentReportsSignedOff")
  incidentReportsEscalated         IncidentReport[]                 @relation("IncidentReportsEscalated")
  incidentReportsFirstAided        IncidentReport[]                 @relation("IncidentReportsFirstAided")
  incidentStaffLinks               IncidentReportStaff[]            @relation("IncidentReportStaffUser")
  incidentAttachmentsUploaded      IncidentReportAttachment[]       @relation("IncidentReportAttachmentsUploaded")
  incidentParentCopiesGenerated    IncidentReportParentCopy[]       @relation("IncidentParentCopiesGenerated")
  incidentParentCopiesShared       IncidentReportParentCopy[]       @relation("IncidentParentCopiesShared")
  incidentParentRecipients         IncidentReportParentRecipient[]  @relation("IncidentParentRecipients")
  incidentEvents                   IncidentReportEvent[]            @relation("IncidentReportEvents")
  messagesSent                     Message[]                        @relation("MessagesSent")
  messageReads                     MessageRead[]
  messageThreadParticipants        MessageThreadParticipant[]
  threadsAsParent                  MessageThread[]                  @relation("ThreadParent")
  threadsAsSupervisor              MessageThread[]                  @relation("ThreadSupervisor")
  threadsAsAdmin                   MessageThread[]                  @relation("ThreadAdmin")
  shopPurchases                    ShopPurchase[]                   @relation("Shopkeeper")
  shopItemsCreated                 ShopItem[]                       @relation("ShopItemsCreated")
  shopReservationsMade             ShopReservation[]                @relation("ShopReservationCreator")
  shopReservationsCollected        ShopReservation[]                @relation("ShopReservationCollector")
  shopReservationsCancelled        ShopReservation[]                @relation("ShopReservationCanceller")
  clubsCreated                     Club[]                           @relation("ClubsCreated")
  clubSignupsCreated               ClubSignup[]                     @relation("SignupsCreated")
  clubNotifications                ClubNotification[]               @relation("ClubNotificationsSent")
  clubAttendanceRecords            ClubAttendance[]                 @relation("RecordedClubAttendance")
  clubLeadAssignments              ClubLeadAssignment[]             @relation("ClubLeadAssignedUsers")
  clubLeadAssignmentsMade          ClubLeadAssignment[]             @relation("ClubLeadAssignmentsMade")
  clubRotaSelections               ClubRotaParticipant[]            @relation("ClubRotaSelectedUsers")
  clubRotaParticipants             ClubRotaParticipant[]            @relation("ClubRotaParticipants")
  clubRotaShifts                   ClubRotaShift[]                  @relation("ClubRotaShifts")
  clubAvailabilityWindows          ClubAvailabilityWindow[]         @relation("ClubAvailability")
  schoolFeeInvoicesCreated         SchoolFeeInvoice[]               @relation("SchoolFeeInvoicesCreated")
  schoolFeeInvoicesMarked          SchoolFeeInvoice[]               @relation("SchoolFeeInvoicesParentMarkedPaid")
  schoolFeeInvoicesConfirmed       SchoolFeeInvoice[]               @relation("SchoolFeeInvoicesPaymentConfirmed")
  schoolFeeDiscountOptOuts         SchoolFeeInvoiceDiscount[]       @relation("SchoolFeeDiscountOptedOutBy")
  auditEvents                      AuditLog[]
  invitationsSent                  UserInvitation[]                 @relation("InvitedUserInvitations")
  acceptedInvitations              UserInvitation[]                 @relation("AcceptedUserInvitations")
  spouseInvitationsSent            UserInvitation[]                 @relation("GuardianLinkInviterInvitations")
  parentRegistration               ParentRegistration?              @relation("ParentRegistrationParent")

  @@index([role])
}

model UserInvitation {
  id                     String                    @id @default(cuid())
  clerkInvitationId      String                    @unique
  role                   Role
  tags                   String[]                  @default([])
  emailEnc               String
  emailBidx              String
  status                 UserInvitationStatus      @default(Pending)
  emailStatus            UserInvitationEmailStatus @default(NotSent)
  emailMessageId         String?
  invitedById            String
  acceptedUserId         String?
  acceptedAt             DateTime?
  guardianLinkInviterId  String?
  guardianLinkStudentIds String[]                  @default([])
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt

  invitedBy           User  @relation("InvitedUserInvitations", fields: [invitedById], references: [id])
  acceptedUser        User? @relation("AcceptedUserInvitations", fields: [acceptedUserId], references: [id])
  guardianLinkInviter User? @relation("GuardianLinkInviterInvitations", fields: [guardianLinkInviterId], references: [id], onDelete: SetNull)

  @@index([emailBidx, status])
  @@index([status, role, createdAt])
  @@index([invitedById, createdAt])
  @@index([acceptedUserId])
  @@index([guardianLinkInviterId, createdAt])
}

// ---------------------------------------------------------------------------
// Students & academic
// ---------------------------------------------------------------------------

model Student {
  id            String   @id @default(cuid())
  userId        String?  @unique
  user          User?    @relation("StudentLogin", fields: [userId], references: [id])
  // --- PII (encrypted) ---
  fullNameEnc   String
  nameBidx      String // HMAC of normalised name for staff search
  dobEnc        String
  addressEnc    String?
  // --- operational ---
  yearGroup     String
  enrolmentDate DateTime
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  guardians                Guardian[]
  subjects                 StudentSubject[]
  paceRecords              PaceRecord[]
  paceProgress             PaceProgress[]
  paceAdvancementApprovals PaceAdvancementApproval[]
  attendance               Attendance[]
  behaviour                BehaviourEntry[]
  childNotes               ChildNote[]
  meritLedger              MeritLedger[]
  titheConfig              TitheConfig?
  titheRuns                TitheRun[]
  investment               InvestmentAccount?
  investmentTx             InvestmentTransaction[]
  shopPurchases            ShopPurchase[]
  shopReservations         ShopReservation[]
  clubSignups              ClubSignup[]
  clubAttendance           ClubAttendance[]
  termReports              TermReport[]
  schoolFeeInvoices        SchoolFeeInvoice[]
  schoolFeeInvoiceLinks    SchoolFeeInvoiceStudent[]
  permissionSlipRecipients PermissionSlipRecipient[]
  incidentReports          IncidentReportStudent[]
  incidentParentCopies     IncidentReportParentCopy[]
  registrationProfile      StudentRegistrationProfile?

  @@index([yearGroup])
  @@index([nameBidx])
}

model Guardian {
  id        String   @id @default(cuid())
  userId    String
  studentId String
  user      User     @relation(fields: [userId], references: [id])
  student   Student  @relation(fields: [studentId], references: [id])
  notesEnc  String?
  createdAt DateTime @default(now())

  @@unique([userId, studentId])
  @@index([studentId])
}

model Subject {
  id                   String                    @id @default(cuid())
  code                 String                    @unique // e.g. "MATH", "ENG", "SOC"
  name                 String
  active               Boolean                   @default(true)
  students             StudentSubject[]
  paces                PaceRecord[]
  progress             PaceProgress[]
  advancementApprovals PaceAdvancementApproval[]
}

model StudentSubject {
  id                String  @id @default(cuid())
  studentId         String
  subjectId         String
  currentPaceNumber Int     @default(1001)
  student           Student @relation(fields: [studentId], references: [id])
  subject           Subject @relation(fields: [subjectId], references: [id])

  @@unique([studentId, subjectId])
}

model YearGroupBand {
  id            String       @id @default(cuid())
  name          String       @unique
  standardYears String[]     @default([])
  active        Boolean      @default(true)
  sortOrder     Int          @default(0)
  colour        String
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  staffShifts   StaffShift[]

  @@index([active, sortOrder])
}

model PaceRecord {
  id            String    @id @default(cuid())
  studentId     String
  subjectId     String
  paceNumber    Int
  selfTestScore Float?
  paceTestScore Float?
  completedAt   DateTime?
  recordedById  String
  createdAt     DateTime  @default(now())

  student               Student                  @relation(fields: [studentId], references: [id])
  subject               Subject                  @relation(fields: [subjectId], references: [id])
  recordedBy            User                     @relation("RecordedPace", fields: [recordedById], references: [id])
  completedPaceProgress PaceProgress[]           @relation("PaceProgressCompletedByRecord")
  advancementApproval   PaceAdvancementApproval? @relation("PaceAdvancementApprovalRecord")
  automaticMeritEntries BehaviourEntry[]         @relation("PaceRecordAutomaticMerit")

  @@index([studentId, subjectId])
}

model PaceProgress {
  id                    String    @id @default(cuid())
  studentId             String
  subjectId             String
  paceNumber            Int
  startedAt             DateTime
  completedAt           DateTime?
  completedByRecordId   String?
  completedByApprovalId String?
  finalTestAttempts     Int       @default(0)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  student             Student                  @relation(fields: [studentId], references: [id])
  subject             Subject                  @relation(fields: [subjectId], references: [id])
  completedByRecord   PaceRecord?              @relation("PaceProgressCompletedByRecord", fields: [completedByRecordId], references: [id])
  completedByApproval PaceAdvancementApproval? @relation("PaceProgressCompletedByApproval", fields: [completedByApprovalId], references: [id])

  @@unique([studentId, subjectId, paceNumber])
  @@index([studentId, subjectId, completedAt])
  @@index([completedByRecordId])
  @@index([completedByApprovalId])
}

model PacePolicy {
  id                          String   @id @default("default")
  dailyTestLimitEnabled       Boolean  @default(false)
  maxTestsPerStudentPerDay    Int      @default(2)
  samePaceSameDayBlockEnabled Boolean  @default(true)
  passThreshold               Int      @default(80)
  updatedAt                   DateTime @updatedAt
}

model PaceAdvancementApproval {
  id           String   @id @default(cuid())
  paceRecordId String   @unique
  studentId    String
  subjectId    String
  paceNumber   Int
  notesEnc     String
  approvedById String
  approvedAt   DateTime @default(now())
  createdAt    DateTime @default(now())

  paceRecord        PaceRecord     @relation("PaceAdvancementApprovalRecord", fields: [paceRecordId], references: [id], onDelete: Restrict)
  student           Student        @relation(fields: [studentId], references: [id])
  subject           Subject        @relation(fields: [subjectId], references: [id])
  approvedBy        User           @relation("ApprovedPaceAdvancements", fields: [approvedById], references: [id])
  completedProgress PaceProgress[] @relation("PaceProgressCompletedByApproval")

  @@index([studentId, subjectId, paceNumber])
  @@index([approvedById, approvedAt])
  @@index([approvedAt])
}

// ---------------------------------------------------------------------------
// Parent-submitted registration
// ---------------------------------------------------------------------------

enum StudentRegistrationConsentType {
  Contact
  EmergencyMedical
  LocalActivities
  PhotoVideo
  Accuracy
}

model ParentRegistration {
  id               String   @id @default(cuid())
  parentUserId     String   @unique
  parentUser       User     @relation("ParentRegistrationParent", fields: [parentUserId], references: [id])
  homeAddressEnc   String
  agreementNameEnc String
  agreementDate    DateTime @db.Date
  submittedAt      DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  guardianContacts  RegistrationGuardianContact[]
  emergencyContacts RegistrationEmergencyContact[]
  pickupContacts    RegistrationPickupContact[]
  studentProfiles   StudentRegistrationProfile[]

  @@index([submittedAt])
}

model RegistrationGuardianContact {
  id                String             @id @default(cuid())
  registrationId    String
  registration      ParentRegistration @relation(fields: [registrationId], references: [id])
  position          Int
  fullNameEnc       String
  relationshipEnc   String
  primaryPhoneEnc   String
  secondaryPhoneEnc String?
  emailEnc          String?
  workPhoneEnc      String?
  addressEnc        String?
  createdAt         DateTime           @default(now())

  @@unique([registrationId, position])
  @@index([registrationId])
}

model RegistrationEmergencyContact {
  id                String             @id @default(cuid())
  registrationId    String
  registration      ParentRegistration @relation(fields: [registrationId], references: [id])
  position          Int
  fullNameEnc       String
  relationshipEnc   String
  primaryPhoneEnc   String
  secondaryPhoneEnc String?
  emailEnc          String?
  canPickUp         Boolean
  createdAt         DateTime           @default(now())

  @@unique([registrationId, position])
  @@index([registrationId])
}

model RegistrationPickupContact {
  id                String             @id @default(cuid())
  registrationId    String
  registration      ParentRegistration @relation(fields: [registrationId], references: [id])
  position          Int
  fullNameEnc       String
  relationshipEnc   String
  phoneEnc          String
  idPasswordNoteEnc String?
  createdAt         DateTime           @default(now())

  @@unique([registrationId, position])
  @@index([registrationId])
}

model StudentRegistrationProfile {
  id                      String             @id @default(cuid())
  registrationId          String
  registration            ParentRegistration @relation(fields: [registrationId], references: [id])
  studentId               String             @unique
  student                 Student            @relation(fields: [studentId], references: [id])
  preferredNameEnc        String?
  genderEnc               String?
  homeLanguageEnc         String?
  studentNotesEnc         String?
  allergiesEnc            String?
  medicalConditionsEnc    String?
  medicationAtCentreEnc   String?
  dietaryRestrictionsEnc  String?
  learningSupportEnc      String?
  interestsStrengthsEnc   String?
  settlingComfortNotesEnc String?
  additionalInfoEnc       String?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  consents StudentRegistrationConsent[]

  @@index([registrationId])
}

model StudentRegistrationConsent {
  id          String                         @id @default(cuid())
  profileId   String
  profile     StudentRegistrationProfile     @relation(fields: [profileId], references: [id])
  consentType StudentRegistrationConsentType
  granted     Boolean
  initialsEnc String
  createdAt   DateTime                       @default(now())

  @@unique([profileId, consentType])
  @@index([profileId])
}

// ---------------------------------------------------------------------------
// Attendance & behaviour
// ---------------------------------------------------------------------------

enum AttendanceStatus {
  Present
  Absent
  Late
}

enum AbsenceReason {
  Sick
  Holiday
  NotScheduled
  Excused
  Unexcused
}

model Attendance {
  id            String           @id @default(cuid())
  studentId     String
  date          DateTime         @db.Date
  status        AttendanceStatus
  absenceReason AbsenceReason?
  recordedById  String
  createdAt     DateTime         @default(now())

  student    Student @relation(fields: [studentId], references: [id])
  recordedBy User    @relation("RecordedAttendance", fields: [recordedById], references: [id])

  @@unique([studentId, date])
  @@index([date])
}

model StaffAttendance {
  id            String           @id @default(cuid())
  staffUserId   String
  date          DateTime         @db.Date
  status        AttendanceStatus
  absenceReason AbsenceReason?
  recordedById  String
  createdAt     DateTime         @default(now())

  staffUser  User @relation("StaffAttendanceUser", fields: [staffUserId], references: [id])
  recordedBy User @relation("RecordedStaffAttendance", fields: [recordedById], references: [id])

  @@unique([staffUserId, date])
  @@index([date])
}

model StaffAvailabilityWindow {
  id          String   @id @default(cuid())
  staffUserId String
  dayOfWeek   Int
  startMinute Int
  endMinute   Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  staffUser User @relation("StaffAvailability", fields: [staffUserId], references: [id])

  @@index([staffUserId, dayOfWeek])
}

model StaffMonthlyAvailabilityWindow {
  id          String   @id @default(cuid())
  staffUserId String
  date        DateTime @db.Date
  startMinute Int
  endMinute   Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  staffUser User @relation("StaffMonthlyAvailability", fields: [staffUserId], references: [id])

  @@index([staffUserId, date])
  @@index([date])
}

enum StaffShiftKind {
  Cover
  Meeting
}

model StaffShift {
  id              String         @id @default(cuid())
  staffUserId     String
  kind            StaffShiftKind @default(Cover)
  yearGroupBandId String?
  date            DateTime       @db.Date
  startsAt        DateTime
  endsAt          DateTime
  notes           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  staffUser        User               @relation("StaffShifts", fields: [staffUserId], references: [id])
  yearGroupBand    YearGroupBand?     @relation(fields: [yearGroupBandId], references: [id])
  fromSwapRequests ShiftSwapRequest[] @relation("FromShift")
  toSwapRequests   ShiftSwapRequest[] @relation("ToShift")

  @@index([staffUserId, date])
  @@index([yearGroupBandId, date])
}

enum ShiftSwapStatus {
  Pending
  Approved
  Rejected
}

model ShiftSwapRequest {
  id              String          @id @default(cuid())
  requesterUserId String
  targetUserId    String
  fromShiftId     String
  toShiftId       String
  status          ShiftSwapStatus @default(Pending)
  approvedById    String?
  reviewedAt      DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  requester  User       @relation("RequestedShiftSwaps", fields: [requesterUserId], references: [id])
  targetUser User       @relation("TargetedShiftSwaps", fields: [targetUserId], references: [id])
  approvedBy User?      @relation("ApprovedShiftSwaps", fields: [approvedById], references: [id])
  fromShift  StaffShift @relation("FromShift", fields: [fromShiftId], references: [id])
  toShift    StaffShift @relation("ToShift", fields: [toShiftId], references: [id])

  @@index([requesterUserId, status])
  @@index([targetUserId, status])
  @@index([fromShiftId, status])
  @@index([toShiftId, status])
}

enum BehaviourType {
  Merit
  Demerit
  General
}

enum BehaviourVisibility {
  General
  Sensitive
}

enum MessageThreadKind {
  ParentStaff
  SupervisorHead
  StaffDirect
  Staffroom
}

model BehaviourEntry {
  id             String              @id @default(cuid())
  clubId         String?
  studentId      String
  type           BehaviourType
  category       String
  // note is free text PII — encrypted at rest (ADR-005)
  noteEnc        String?
  visibility     BehaviourVisibility @default(General)
  // Merit: positive N. Demerit: negative chosen amount, defaulting to -5. General: 0.
  meritDelta     Int
  recordedById   String
  paceRecordId   String?
  deletedAt      DateTime?
  deletedById    String?
  seenAt         DateTime?
  seenById       String?
  headCommentEnc String?
  createdAt      DateTime            @default(now())

  club       Club?         @relation(fields: [clubId], references: [id], onDelete: SetNull)
  student    Student       @relation(fields: [studentId], references: [id])
  recordedBy User          @relation("RecordedBehaviour", fields: [recordedById], references: [id])
  deletedBy  User?         @relation("DeletedBehaviour", fields: [deletedById], references: [id], onDelete: SetNull)
  seenBy     User?         @relation("SeenBehaviour", fields: [seenById], references: [id], onDelete: SetNull)
  paceRecord PaceRecord?   @relation("PaceRecordAutomaticMerit", fields: [paceRecordId], references: [id], onDelete: SetNull)
  ledgerRows MeritLedger[]

  @@index([clubId, createdAt])
  @@index([studentId, createdAt])
  @@index([visibility])
  @@index([paceRecordId])
  @@index([deletedAt])
  @@index([deletedById])
  @@index([seenAt])
  @@index([seenById])
}

model ChildNote {
  id             String    @id @default(cuid())
  studentId      String
  noteEnc        String
  sensitive      Boolean   @default(false)
  createdById    String
  deletedAt      DateTime?
  deletedById    String?
  seenAt         DateTime?
  seenById       String?
  headCommentEnc String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  student   Student @relation(fields: [studentId], references: [id])
  createdBy User    @relation("ChildNotesCreated", fields: [createdById], references: [id])
  deletedBy User?   @relation("DeletedChildNotes", fields: [deletedById], references: [id], onDelete: SetNull)
  seenBy    User?   @relation("SeenChildNotes", fields: [seenById], references: [id], onDelete: SetNull)

  @@index([studentId, createdAt])
  @@index([sensitive])
  @@index([createdById, createdAt])
  @@index([deletedAt])
  @@index([deletedById])
  @@index([seenAt])
  @@index([seenById])
}

// ---------------------------------------------------------------------------
// Merit economy (three-account double-entry ledger)
// ---------------------------------------------------------------------------

enum MeritAccount {
  Spend
  Saving
  Investment
  InvestmentReturn
  TithePaid
  Given
  FeeSink
  ShopReserved
}

model MeritLedger {
  id             String       @id @default(cuid())
  studentId      String
  account        MeritAccount
  delta          Int // signed integer merits
  reason         String
  relatedEntryId String?
  createdAt      DateTime     @default(now())

  student      Student         @relation(fields: [studentId], references: [id])
  relatedEntry BehaviourEntry? @relation(fields: [relatedEntryId], references: [id])

  @@index([studentId, account])
  @@index([studentId, createdAt])
}

model TitheConfig {
  studentId  String    @id
  percentage Int       @default(10) // 10 | 15 | 20
  cadence    String    @default("Weekly")
  lastRunAt  DateTime?

  student Student @relation(fields: [studentId], references: [id])
}

model TitheRun {
  id          String   @id @default(cuid())
  studentId   String
  periodStart DateTime
  periodEnd   DateTime
  grossMerits Int
  titheAmount Int
  createdAt   DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id])

  @@unique([studentId, periodStart])
}

model InvestmentAccount {
  studentId String  @id
  units     Decimal @default(0) @db.Decimal(18, 6)

  student Student @relation(fields: [studentId], references: [id])
}

model InvestmentNav {
  date        DateTime @id @db.Date
  nav         Decimal  @db.Decimal(18, 6)
  dailyReturn Decimal  @db.Decimal(10, 6)
}

enum InvestmentTxType {
  Buy
  Sell
}

model InvestmentTransaction {
  id        String           @id @default(cuid())
  studentId String
  type      InvestmentTxType
  units     Decimal          @db.Decimal(18, 6)
  nav       Decimal          @db.Decimal(18, 6)
  feeMerits Int              @default(0)
  createdAt DateTime         @default(now())

  student Student @relation(fields: [studentId], references: [id])

  @@index([studentId, createdAt])
}

// ---------------------------------------------------------------------------
// Shop (in-app)
// ---------------------------------------------------------------------------

enum ShopCategory {
  Treats
  Privileges
  Stationery
  Accessories
  Toys
  Vouchers
  Merch
  Recognition
}

enum ShopReservationStatus {
  Ready
  Collected
  Cancelled
}

model ShopItem {
  id                String       @id @default(cuid())
  name              String
  photoUrl          String?
  category          ShopCategory @default(Treats)
  blurb             String?
  description       String?
  priceExVat        Int // merits, VAT-exclusive
  vatRatePct        Int          @default(20)
  priceIncVat       Int // merits, VAT-inclusive (derived but stored for auditability)
  stockCount        Int          @default(0)
  lowStockThreshold Int          @default(5)
  active            Boolean      @default(true)
  createdById       String
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  createdBy        User                  @relation("ShopItemsCreated", fields: [createdById], references: [id])
  purchases        ShopPurchase[]
  reservationLines ShopReservationLine[]

  @@index([active])
  @@index([category, active])
}

model ShopPurchase {
  id               String   @id @default(cuid())
  studentId        String
  itemId           String
  unitsBought      Int
  totalPriceMerits Int
  shopkeeperId     String
  createdAt        DateTime @default(now())

  student    Student  @relation(fields: [studentId], references: [id])
  item       ShopItem @relation(fields: [itemId], references: [id])
  shopkeeper User     @relation("Shopkeeper", fields: [shopkeeperId], references: [id])

  @@index([studentId, createdAt])
  @@index([itemId, createdAt])
