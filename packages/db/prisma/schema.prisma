enum ClubScheduleFrequency {
  Weekly
}

model Club {
  id                  String                 @id @default(cuid())
  name                String
  description         String?
  schedule            String?
  scheduleStartDate   DateTime?              @db.Date
  scheduleStartMinute Int?
  scheduleEndMinute   Int?
  scheduleFrequency   ClubScheduleFrequency?
  capacity            Int?
  iconKey             String?
  accentColor         String?
  active              Boolean                @default(true)
  createdById         String
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

