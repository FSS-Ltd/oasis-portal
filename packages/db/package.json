{
  "name": "@oasis/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./encryption": "./src/encryption.ts"
  },
  "scripts": {
    "generate": "prisma generate",
    "migrate": "pnpm migrate:deploy && pnpm rls:apply && pnpm realtime:configure && pnpm realtime:check",
    "migrate:dev": "prisma migrate dev && pnpm rls:apply && pnpm realtime:configure && pnpm realtime:check",
    "migrate:deploy": "prisma migrate deploy",
    "rls:apply": "tsx scripts/apply-rls.ts",
    "db:integration": "tsx scripts/smoke-rls.ts",
    "verify:encryption": "tsx scripts/verify-encryption.ts",
    "bootstrap:head": "tsx scripts/bootstrap-head.ts",
    "seed": "tsx prisma/seed.ts",
    "lint": "eslint src scripts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "realtime:configure": "tsx scripts/realtime-configuration.ts configure",
    "realtime:check": "tsx scripts/realtime-configuration.ts check",
    "realtime:preflight": "tsx scripts/realtime-configuration.ts preflight",
    "test:realtime": "tsx scripts/test-realtime.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0"
  },
  "devDependencies": {
    "@oasis/config": "workspace:*",
    "@types/node": "^22.10.0",
    "prisma": "^6.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
