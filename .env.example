# Copy to .env.local and fill in. Never commit real secrets.

# --- App ---
NODE_ENV=development
APP_URL=http://localhost:3000

# --- Database (Postgres, eu-west-2 in prod) ---
# Local Docker creates an owner role (`oasis`) for migrations and a runtime role
# (`oasis_app`) for the app. Keep this split so local dev matches production RLS.
DATABASE_URL=postgresql://oasis_app:oasis_app@localhost:5432/oasis_dev
DIRECT_URL=postgresql://oasis:oasis@localhost:5432/oasis_dev

# --- Supabase project (browser-safe publishable key only) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only key used to mint signed Storage upload/download URLs. Never expose it to clients.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_HOMEWORK_SUBMISSIONS_BUCKET=homework-submissions
SUPABASE_NOTICE_ATTACHMENTS_BUCKET=notice-attachments
SUPABASE_SHOP_ITEM_PHOTOS_BUCKET=shop-item-photos

# --- Clerk (UK/EU residency) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
EXPO_PUBLIC_TRPC_URL=http://localhost:3000/api/trpc

# --- PII envelope encryption (ADR-0006) ---
# Master key wraps per-record DEKs. 32 random bytes, base64-encoded.
# Generate with: node -e "console.log(crypto.randomBytes(32).toString('base64'))"
OASIS_MASTER_KEY=
OASIS_MASTER_KEY_VERSION=1
# Older versions kept available during rotation, e.g. OASIS_MASTER_KEY_V2=...
# Pepper for HMAC blind indexes. Never logged, never in DB.
OASIS_BIDX_PEPPER=

# --- Email (Resend, EU) ---
RESEND_API_KEY=
RESEND_FROM="Oasis Portal <no-reply@oasisportal.space>"

# --- Observability ---
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
AXIOM_TOKEN=

# --- CI cache secrets (GitHub Actions repository secrets, not local runtime) ---
# Vercel/Turborepo remote cache token.
TURBO_TOKEN=
# Vercel team slug used by Turborepo remote cache.
TURBO_TEAM=
# Optional HMAC key for signed Turbo remote cache artifacts.
# Generate with: node -e "console.log(crypto.randomBytes(32).toString('base64'))"
TURBO_REMOTE_CACHE_SIGNATURE_KEY=

# --- Investment simulator ---
INVESTMENT_NAV_SEED=oasis-v1

# --- Twelve Data market data (server-only) ---
TWELVE_DATA_API_KEY=

# --- Feature flags ---
FEATURE_PUSH_NOTIFICATIONS=false
# Disabled until the production tenant is upgraded to Clerk Pro for required MFA.
OASIS_ENFORCE_2FA=false
