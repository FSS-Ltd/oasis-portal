# Copy to .env.local and fill in. Never commit real secrets.

# --- App ---
NODE_ENV=development
APP_URL=http://localhost:3000

# --- Database (Postgres, eu-west-2 in prod) ---
DATABASE_URL=postgresql://oasis:oasis@localhost:5432/oasis_dev
DIRECT_URL=postgresql://oasis:oasis@localhost:5432/oasis_dev

# --- Clerk (UK/EU residency) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# --- AWS KMS (envelope encryption for PII, ADR-005) ---
AWS_REGION=eu-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
KMS_KEY_ID=
# Peppers for blind indexes (HMAC-SHA256). Never logged, never in DB.
BLIND_INDEX_PEPPER_EMAIL=
BLIND_INDEX_PEPPER_NAME=

# --- Email (Resend, EU) ---
RESEND_API_KEY=
RESEND_FROM=no-reply@oasislearningcentre.example

# --- Observability ---
SENTRY_DSN=
AXIOM_TOKEN=

# --- Investment simulator ---
INVESTMENT_NAV_SEED=oasis-v1

# --- Feature flags ---
FEATURE_PUSH_NOTIFICATIONS=false
