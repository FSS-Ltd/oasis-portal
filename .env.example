# Copy to .env.local and fill in. Never commit real secrets.

# --- App ---
NODE_ENV=development
APP_URL=http://localhost:3000

# --- Database (Postgres, eu-west-2 in prod) ---
DATABASE_URL=postgresql://oasis:oasis@localhost:5432/oasis_dev
DIRECT_URL=postgresql://oasis:oasis@localhost:5432/oasis_dev

# --- Clerk (UK/EU residency) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# --- PII envelope encryption (ADR-0006) ---
# Master key wraps per-record DEKs. 32 random bytes, base64-encoded.
# Generate with: node -e "console.log(crypto.randomBytes(32).toString('base64'))"
OASIS_MASTER_KEY=
OASIS_MASTER_KEY_VERSION=1
# Older versions kept available during rotation, e.g. OASIS_MASTER_KEY_V2=...
# Pepper for HMAC blind indexes. Never logged, never in DB.
OASIS_BIDX_PEPPER=

# --- Email (Resend, EU) ---
RESEND_API_KEY=
RESEND_FROM=no-reply@oasislearningcentre.example

# --- Observability ---
SENTRY_DSN=
AXIOM_TOKEN=

# --- Investment simulator ---
INVESTMENT_NAV_SEED=oasis-v1

# --- Feature flags ---
FEATURE_PUSH_NOTIFICATIONS=false
