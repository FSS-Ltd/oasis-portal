{
  "expo": {
    "name": "Oasis",
    "slug": "oasis-mobile",
    "version": "0.0.0",
    "orientation": "portrait",
    "scheme": "oasis",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "uk.oasis.portal"
    },
    "android": {
      "package": "uk.oasis.portal"
    },
    "plugins": ["expo-router", "expo-secure-store"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
