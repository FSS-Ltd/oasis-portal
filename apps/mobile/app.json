{
  "expo": {
    "name": "Oasis",
    "slug": "oasis-mobile",
    "version": "0.0.0",
    "orientation": "portrait",
    "scheme": "oasis",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "uk.oasis.portal"
    },
    "android": {
      "package": "uk.oasis.portal"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/oasis-logo.png",
      "name": "Oasis Portal",
      "shortName": "Oasis",
      "themeColor": "#1B2B5E",
      "backgroundColor": "#EEF2F9"
    },
    "plugins": ["expo-router", "expo-secure-store"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
