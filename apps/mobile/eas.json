{
  "cli": {
    "appVersionSource": "remote",
    "version": ">= 13.0.0"
  },
  "build": {
    "internal-ios": {
      "distribution": "internal",
      "env": {
        "OASIS_BUILD_PROFILE": "internal-ios"
      },
      "environment": "preview",
      "ios": {
        "simulator": false
      }
    },
    "internal-android": {
      "android": {
        "buildType": "apk"
      },
      "distribution": "internal",
      "env": {
        "OASIS_BUILD_PROFILE": "internal-android"
      },
      "environment": "preview"
    },
    "release-candidate-ios": {
      "autoIncrement": true,
      "distribution": "store",
      "env": {
        "OASIS_BUILD_PROFILE": "release-candidate-ios"
      },
      "environment": "production",
      "ios": {
        "simulator": false
      }
    },
    "release-candidate-android": {
      "android": {
        "buildType": "app-bundle"
      },
      "autoIncrement": true,
      "distribution": "store",
      "env": {
        "OASIS_BUILD_PROFILE": "release-candidate-android"
      },
      "environment": "production"
    }
  }
}
