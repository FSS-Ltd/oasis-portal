{
  "name": "@oasis/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "node ../../scripts/with-env.mjs expo start",
    "ios": "node ../../scripts/with-env.mjs expo start --ios",
    "android": "node ../../scripts/with-env.mjs expo start --android",
    "build:web": "node ../../scripts/with-env.mjs expo export --platform web --output-dir dist && node scripts/generate-service-worker.mjs dist && node scripts/check-pwa-readiness.mjs dist",
    "eas": "pnpm dlx eas-cli@^13.0.0",
    "eas:check": "node scripts/check-eas-build-config.mjs",
    "serve:web": "node scripts/serve-web-export.mjs dist",
    "pwa:check": "node scripts/check-pwa-readiness.mjs",
    "test": "vitest run && node --test tests/**/*.test.mjs",
    "test:e2e": "node ../../scripts/with-env.mjs node scripts/run-maestro-e2e.mjs",
    "test:pwa": "playwright test --config playwright.pwa.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app src"
  },
  "dependencies": {
    "@babel/runtime": "7.29.2",
    "@clerk/clerk-expo": "^2.6.0",
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "15.1.1",
    "@oasis/api": "workspace:*",
    "@oasis/domain": "workspace:*",
    "@supabase/supabase-js": "2.104.1",
    "@tanstack/react-query": "^5.62.0",
    "@trpc/client": "^11.0.0-rc.600",
    "@trpc/react-query": "^11.0.0-rc.600",
    "expo": "~54.0.38",
    "expo-application": "~7.0.8",
    "expo-asset": "~12.0.14",
    "expo-auth-session": "~7.0.11",
    "expo-blur": "~15.0.8",
    "expo-camera": "^17.0.10",
    "expo-constants": "~18.0.14",
    "expo-crypto": "~15.0.9",
    "expo-file-system": "~19.0.24",
    "expo-font": "~14.0.12",
    "expo-glass-effect": "~0.1.10",
    "expo-haptics": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-web-browser": "~15.0.11",
    "lucide-react": "^1.11.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.4",
    "superjson": "^2.2.1"
  },
  "devDependencies": {
    "@oasis/config": "workspace:*",
    "@playwright/test": "^1.59.1",
    "@types/node": "^22.10.0",
    "@types/react": "~19.1.17",
    "react-test-renderer": "19.1.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8",
    "workbox-build": "^7.3.0"
  }
}
