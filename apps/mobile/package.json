{
  "name": "@oasis/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "node ../../scripts/with-env.mjs expo start",
    "ios": "node ../../scripts/with-env.mjs expo start --ios",
    "android": "node ../../scripts/with-env.mjs expo start --android",
    "build:web": "node ../../scripts/with-env.mjs expo export --platform web --output-dir dist && node scripts/generate-service-worker.mjs dist && node scripts/check-pwa-readiness.mjs dist",
    "eas": "pnpm dlx eas-cli@^13.0.0",
    "eas:check": "node scripts/check-eas-build-config.mjs",
    "serve:web": "node scripts/serve-web-export.mjs dist",
    "pwa:check": "node scripts/check-pwa-readiness.mjs",
    "test": "vitest run && node --test tests/**/*.test.mjs",
    "test:e2e": "node ../../scripts/with-env.mjs node scripts/run-maestro-e2e.mjs",
    "test:pwa": "playwright test --config playwright.pwa.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app src"
  },
  "dependencies": {
    "@babel/runtime": "7.29.2",
    "@clerk/clerk-expo": "^2.6.0",
    "@expo/vector-icons": "14.0.4",
    "@oasis/api": "workspace:*",
    "@oasis/domain": "workspace:*",
    "@tanstack/react-query": "^5.62.0",
    "@trpc/client": "^11.0.0-rc.600",
    "@trpc/react-query": "^11.0.0-rc.600",
    "expo": "~52.0.0",
    "expo-application": "~6.0.2",
    "expo-asset": "~11.0.5",
    "expo-auth-session": "~6.0.3",
    "expo-camera": "^16.0.18",
    "expo-constants": "~17.0.8",
    "expo-crypto": "~14.0.2",
    "expo-file-system": "~18.0.12",
    "expo-image-picker": "^16.0.6",
    "expo-linking": "~7.0.5",
    "expo-router": "~4.0.0",
    "expo-secure-store": "~14.0.0",
    "expo-sharing": "~13.0.1",
    "expo-status-bar": "~2.0.0",
    "expo-web-browser": "~14.0.2",
    "lucide-react": "^1.11.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.9",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-web": "~0.19.13",
    "superjson": "^2.2.1"
  },
  "devDependencies": {
    "@oasis/config": "workspace:*",
    "@playwright/test": "^1.59.1",
    "@types/node": "^22.10.0",
    "@types/react": "~18.3.12",
    "react-test-renderer": "18.3.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8",
    "workbox-build": "^7.3.0"
  }
}
