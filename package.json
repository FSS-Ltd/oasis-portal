{
  "name": "oasis-portal",
  "private": true,
  "version": "0.0.0",
  "description": "Oasis Learning Centre platform monorepo",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "postinstall": "pnpm --filter @oasis/db generate",
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "dev:watch": "nodemon --config nodemon.json",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "test:e2e": "turbo run test:e2e",
    "docs:component-map": "node scripts/generate-component-map.mjs",
    "tech-debt:validate-memory": "node scripts/validate-tech-debt-review-memory.mjs",
    "hooks:install": "sh scripts/install-git-hooks.sh",
    "with-env": "node scripts/with-env.mjs",
    "db:generate": "node scripts/with-env.mjs pnpm --filter @oasis/db generate",
    "db:dev:up": "docker compose up -d postgres",
    "db:dev:down": "docker compose down",
    "db:dev:logs": "docker compose logs -f postgres",
    "db:dev:reset": "docker compose down -v && docker compose up -d postgres",
    "db:dev:setup": "pnpm db:dev:up && pnpm db:generate && pnpm db:migrate && pnpm db:seed",
    "db:migrate": "node scripts/with-env.mjs pnpm --filter @oasis/db migrate",
    "db:integration": "node scripts/with-env.mjs pnpm --filter @oasis/db db:integration",
    "api:smoke-context-rls": "node scripts/with-env.mjs pnpm --filter @oasis/api smoke:context-rls",
    "verify:encryption": "node scripts/with-env.mjs pnpm --filter @oasis/db verify:encryption",
    "db:seed": "node scripts/with-env.mjs pnpm --filter @oasis/db seed",
    "bootstrap:head": "node scripts/with-env.mjs pnpm --filter @oasis/db bootstrap:head",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\""
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@clerk/shared",
      "@prisma/client",
      "@prisma/engines",
      "browser-tabs-lock",
      "bufferutil",
      "core-js",
      "esbuild",
      "prisma",
      "sharp",
      "unrs-resolver",
      "utf-8-validate"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "eslint": "^9.14.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.3.3",
    "turbo": "^2.3.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.59.0"
  }
}
