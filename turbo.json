{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".env.local"],
  "remoteCache": {
    "signature": true
  },
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "env": [
        "APP_URL",
        "FEATURE_PUSH_NOTIFICATIONS",
        "INVESTMENT_NAV_SEED",
        "NEXT_PUBLIC_*",
        "NODE_ENV",
        "OASIS_ENFORCE_2FA"
      ],
      "passThroughEnv": [
        "AXIOM_TOKEN",
        "CLERK_SECRET_KEY",
        "CLERK_WEBHOOK_SIGNING_SECRET",
        "DATABASE_URL",
        "DIRECT_URL",
        "OASIS_BIDX_PEPPER",
        "OASIS_MASTER_KEY",
        "OASIS_MASTER_KEY_VERSION",
        "RESEND_API_KEY",
        "RESEND_FROM",
        "SENTRY_AUTH_TOKEN",
        "SENTRY_DSN",
        "SENTRY_ORG",
        "SENTRY_PROJECT"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "outputs": ["playwright-report/**", "test-results/**"]
    }
  }
}
